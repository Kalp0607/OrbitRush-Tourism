<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Verify Code & Reset Password | OrbitRush</title>
    <style>
      .auth-page {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0369a1 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .auth-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
      }

      .auth-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: var(--orbit-radius-lg);
        padding: 3rem 2.5rem;
        max-width: 440px;
        width: 100%;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.8);
      }

      .auth-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .auth-icon-circle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 1rem;
      }

      .auth-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.3rem;
      }

      .auth-subtitle {
        color: #64748b;
        font-size: 0.92rem;
        line-height: 1.5;
        margin: 0;
      }

      .orbit-auth-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.4rem;
      }

      .orbit-auth-input {
        width: 100%;
        padding: 0.85rem 1.2rem;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: var(--orbit-transition);
        font-family: inherit;
      }

      .orbit-auth-input:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .btn-auth-submit {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border: none;
        width: 100%;
        padding: 0.95rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        box-shadow: 0 8px 25px rgba(2, 132, 199, 0.35);
        margin-top: 1rem;
      }

      .btn-auth-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(2, 132, 199, 0.45);
        color: white;
      }
    </style>
  </head>

  <body class="auth-page">
    <%- include("partials/nav") %>

    <main class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-icon-circle">
            <i class="fas fa-shield-alt"></i>
          </div>
          <h1 class="auth-title">Verify Code</h1>
          <p class="auth-subtitle">
            Enter the 6-digit code sent to <strong><%= email %></strong> and set your new password.
          </p>
        </div>

        <form action="/user/forgot-password/reset" method="post">
          <input type="hidden" name="email" value="<%= email %>" />

          <div class="mb-3">
            <label for="otp" class="orbit-auth-label">6-Digit Verification Code</label>
            <input
              type="text"
              class="orbit-auth-input"
              id="otp"
              name="otp"
              placeholder="e.g. 849201"
              maxlength="6"
              style="letter-spacing: 4px; font-weight: 700; text-align: center; font-size: 1.2rem;"
              required
            />
          </div>

          <div class="mb-3">
            <label for="newPassword" class="orbit-auth-label">New Password</label>
            <input
              type="password"
              class="orbit-auth-input"
              id="newPassword"
              name="newPassword"
              placeholder="Create new password"
              required
            />
          </div>

          <button type="submit" class="btn-auth-submit">
            <span>Reset Password & Login</span>
            <i class="fas fa-check ms-1"></i>
          </button>
        </form>
      </div>
    </main>

    <%- include("partials/scripts") %>
  </body>
</html>
