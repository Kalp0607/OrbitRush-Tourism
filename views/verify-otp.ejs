<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Verify OTP | OrbitRush Tourism</title>
    <style>
      body {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      }
      .form-control {
        border-radius: 0.5rem;
      }
      .btn-success {
        border-radius: 0.5rem;
        padding: 0.6rem 1.2rem;
        font-weight: 500;
      }
      .header-title {
        text-align: center;
        font-weight: 600;
        color: #2a5298;
      }
    </style>
  </head>
  <body>
    <%- include("partials/nav") %>

    <div class="container d-flex justify-content-center align-items-center flex-grow-1">
      <div class="card p-4 mt-5" style="max-width: 400px; width: 100%">
        <h3 class="header-title mb-3">Verify OTP 🔑</h3>
        <p class="text-center text-muted mb-4">
          Enter the 6-digit OTP sent to your email and your new password.
        </p>

        <% if (locals.message) { %>
        <div class="alert alert-success text-center mb-3" role="alert">
          <%= locals.message %>
        </div>
        <% } %>

        <% if (locals.error) { %>
        <div class="alert alert-danger text-center mb-3" role="alert">
          <%= locals.error %>
        </div>
        <% } %>

        <form action="/user/forgot-password/reset" method="POST">
          <input type="hidden" name="email" value="<%= email %>" />

          <div class="mb-3">
            <label for="otp" class="form-label fw-semibold">OTP Code</label>
            <input
              type="text"
              class="form-control"
              id="otp"
              name="otp"
              placeholder="Enter OTP"
              required
            />
          </div>

          <div class="mb-3">
            <label for="newPassword" class="form-label fw-semibold">New Password</label>
            <input
              type="password"
              class="form-control"
              id="newPassword"
              name="newPassword"
              placeholder="Enter New Password"
              required
            />
          </div>

          <div class="d-grid mt-4">
            <button type="submit" class="btn btn-success">Reset Password</button>
          </div>
        </form>
      </div>
    </div>

    <%- include("partials/scripts") %>
  </body>
</html>
