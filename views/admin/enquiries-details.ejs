<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Customer Inquiries | Admin Control Panel</title>
    <style>
      .admin-layout {
        background-color: #f1f5f9;
        min-height: 100vh;
        padding-bottom: 5rem;
      }

      .admin-topbar {
        background: #0f172a;
        color: white;
        padding: 1.25rem 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }

      .admin-nav-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .admin-nav-btn {
        color: #cbd5e1;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.88rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: var(--orbit-transition);
      }

      .admin-nav-btn:hover, .admin-nav-btn.active {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
      }

      .admin-nav-btn.active {
        background: var(--orbit-primary);
      }

      .dashboard-body {
        max-width: 1380px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
      }

      .admin-table-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        overflow: hidden;
      }

      .table-card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .admin-table {
        width: 100%;
        border-collapse: collapse;
      }

      .admin-table th {
        background: #f8fafc;
        padding: 1rem 1.2rem;
        font-size: 0.78rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
      }

      .admin-table td {
        padding: 1.2rem 1.2rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: top;
        font-size: 0.9rem;
      }

      .admin-table tr:hover td {
        background: #f8fafc;
      }
    </style>
  </head>

  <body class="admin-layout">
    <header class="admin-topbar">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
          <img src="/images/1760177356614.png" alt="OrbitRush" style="width: 34px; height: 34px; border-radius: 8px;" />
          <span style="font-family: var(--orbit-font-heading); font-weight: 800; font-size: 1.25rem;">OrbitRush Admin</span>
        </div>

        <nav class="admin-nav-links">
          <a href="/tour/admin/dashboard" class="admin-nav-btn">
            <i class="fas fa-mountain"></i> Tours
          </a>
          <a href="/booking/admin/bookings" class="admin-nav-btn">
            <i class="fas fa-calendar-check"></i> Bookings
          </a>
          <a href="/tour/admin/dashboard/enquiries-details" class="admin-nav-btn active">
            <i class="fas fa-clipboard-list"></i> Inquiries
          </a>
          <a href="/tour/admin/dashboard/custom-enquiries" class="admin-nav-btn">
            <i class="fas fa-magic"></i> AI Trips
          </a>
          <a href="/tour/admin/chat" class="admin-nav-btn">
            <i class="fas fa-comments"></i> Live Chat
          </a>
          <a href="/tour/admin/dashboard/user-details" class="admin-nav-btn">
            <i class="fas fa-users"></i> Users
          </a>
          <a href="/" class="admin-nav-btn" style="background: rgba(255,255,255,0.08);">
            <i class="fas fa-external-link-alt"></i> View Site
          </a>
        </nav>
      </div>
    </header>

    <main class="dashboard-body">
      <div class="admin-table-card">
        <div class="table-card-header">
          <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--orbit-dark); margin: 0;">Standard Tour Inquiries</h2>
            <small class="text-muted">Total Received: <%= enquiries ? enquiries.length : 0 %></small>
          </div>
        </div>

        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Tour Requested</th>
                <th>Phone / WhatsApp</th>
                <th>Party</th>
                <th>Preferred Date</th>
                <th>Message / Custom Notes</th>
                <th>Date Received</th>
              </tr>
            </thead>
            <tbody>
              <% if (enquiries && enquiries.length > 0) { %>
                <% enquiries.forEach(enquiry => { %>
                  <tr>
                    <td>
                      <div style="font-weight: 800; color: var(--orbit-dark);"><%= enquiry.fullName %></div>
                      <small class="text-muted"><%= enquiry.email %></small>
                    </td>
                    <td>
                      <strong style="color: var(--orbit-primary);"><%= enquiry.tourName %></strong>
                    </td>
                    <td>
                      <a href="tel:<%= enquiry.phone %>" style="color: #334155; text-decoration: none; font-weight: 600;">
                        <i class="fas fa-phone-alt text-primary me-1"></i> <%= enquiry.phone %>
                      </a>
                    </td>
                    <td>
                      <span class="badge bg-secondary"><%= enquiry.numberOfPeople %> Travelers</span>
                    </td>
                    <td>
                      <strong>
                        <%= enquiry.preferredDate ? new Date(enquiry.preferredDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Flexible' %>
                      </strong>
                    </td>
                    <td style="max-width: 280px;">
                      <div style="font-size: 0.85rem; color: #475569; line-height: 1.4;">
                        <%= enquiry.message || 'No notes provided' %>
                      </div>
                    </td>
                    <td>
                      <%= new Date(enquiry.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    <i class="fas fa-inbox fa-3x mb-3 opacity-50"></i>
                    <p>No standard inquiries received yet.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include("../partials/scripts") %>
  </body>
</html>
