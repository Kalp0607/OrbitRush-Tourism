<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Live Customer Support Console | OrbitRush Admin</title>
    <style>
      body {
        background: #0f172a;
        color: #1e293b;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .admin-chat-topbar {
        background: #0f172a;
        color: white;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .admin-chat-topbar a {
        color: #94a3b8;
        text-decoration: none;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: var(--orbit-transition);
        font-size: 0.9rem;
      }

      .admin-chat-topbar a:hover {
        color: #ffffff;
      }

      .chat-workspace {
        flex: 1;
        display: flex;
        overflow: hidden;
        margin: 1.25rem 2rem 2rem;
        background: white;
        border-radius: var(--orbit-radius-lg);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      /* Sidebar with connected rooms */
      .rooms-sidebar {
        width: 360px;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
      }

      .rooms-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        background: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .rooms-header h3 {
        font-size: 1.05rem;
        color: var(--orbit-dark);
        font-weight: 800;
        margin: 0;
      }

      .rooms-list {
        flex: 1;
        overflow-y: auto;
      }

      .room-item {
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: var(--orbit-transition);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .room-item:hover {
        background: #f1f5f9;
      }

      .room-item.active {
        background: #e0f2fe;
        border-left: 4px solid var(--orbit-primary);
      }

      .room-info h5 {
        font-size: 0.95rem;
        color: var(--orbit-dark);
        margin-bottom: 4px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .room-info p {
        font-size: 0.82rem;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 240px;
        margin: 0;
      }

      .live-dot {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
      }

      .unread-badge {
        background: #22c55e;
        color: white;
        font-size: 0.72rem;
        padding: 3px 9px;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
      }

      /* Main Chat Console */
      .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: white;
      }

      .chat-header {
        padding: 1.2rem 1.8rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: white;
      }

      .chat-messages {
        flex: 1;
        padding: 1.8rem;
        overflow-y: auto;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .message-row {
        display: flex;
        flex-direction: column;
        max-width: 72%;
      }

      .message-row.sent {
        align-self: flex-end;
        align-items: flex-end;
      }

      .message-row.received {
        align-self: flex-start;
        align-items: flex-start;
      }

      .message-bubble {
        padding: 12px 18px;
        border-radius: 18px;
        font-size: 0.92rem;
        line-height: 1.5;
        word-break: break-word;
      }

      .sent .message-bubble {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border-bottom-right-radius: 4px;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
      }

      .received .message-bubble {
        background: white;
        color: #1e293b;
        border-bottom-left-radius: 4px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
      }

      .message-sender {
        font-size: 0.72rem;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 700;
      }

      .message-time {
        font-size: 0.68rem;
        opacity: 0.75;
        margin-top: 4px;
        text-align: right;
      }

      .chat-input-area {
        padding: 1.2rem 1.8rem;
        border-top: 1px solid #e2e8f0;
        display: flex;
        gap: 12px;
        background: white;
        align-items: center;
      }

      .chat-input-area input {
        flex: 1;
        padding: 12px 20px;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-full);
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s;
        font-family: inherit;
      }

      .chat-input-area input:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .chat-input-area button {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        cursor: pointer;
        transition: var(--orbit-transition);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .chat-input-area button:hover {
        transform: scale(1.03);
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.35);
      }

      .no-chat-selected {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 1.05rem;
        flex-direction: column;
        gap: 12px;
        text-align: center;
        padding: 2rem;
      }

      @media (max-width: 900px) {
        .chat-workspace {
          flex-direction: column;
          margin: 1rem;
        }
        .rooms-sidebar {
          width: 100%;
          height: 200px;
        }
      }
    </style>
  </head>

  <body>
    <header class="admin-chat-topbar">
      <a href="/tour/admin/dashboard">
        <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
      </a>
      <h2 style="font-size: 1.25rem; font-weight: 800; color: white; margin: 0;">
        <i class="fas fa-headset text-primary me-2"></i> Live Customer Support Workspace
      </h2>
      <div style="font-size: 0.88rem; color: #cbd5e1;">
        Admin: <strong><%= locals.user ? locals.user.fullName : 'Concierge Admin' %></strong>
      </div>
    </header>

    <div class="chat-workspace">
      <!-- Active Connected Customer Rooms Sidebar -->
      <aside class="rooms-sidebar">
        <div class="rooms-header">
          <h3><i class="fas fa-users text-primary me-2"></i> Active Travelers</h3>
          <span id="room-count-badge" class="unread-badge">0</span>
        </div>
        <div id="rooms-list" class="rooms-list">
          <div style="padding: 2rem; color: #94a3b8; text-align: center;">
            <i class="fas fa-circle-notch fa-spin me-2"></i> Connecting to live stream...
          </div>
        </div>
      </aside>

      <!-- Main Chat Area -->
      <section class="chat-main">
        <div id="active-chat-header" class="chat-header" style="display: none;">
          <div>
            <h4 id="active-user-name" style="margin: 0; font-size: 1.15rem; font-weight: 800; color: var(--orbit-dark);">
              Select conversation
            </h4>
            <p id="active-room-id" style="margin: 2px 0 0 0; font-size: 0.78rem; color: #64748b; font-family: monospace;"></p>
          </div>
          <div>
            <span id="status-badge" class="badge" style="background: #22c55e; color: white; padding: 6px 12px; border-radius: 9999px; font-size: 0.78rem; font-weight: 700;">
              <i class="fas fa-circle me-1" style="font-size: 0.55rem;"></i> Live Connected
            </span>
          </div>
        </div>

        <div id="chat-messages" class="chat-messages">
          <div class="no-chat-selected">
            <i class="fas fa-comments" style="font-size: 3.5rem; color: #cbd5e1;"></i>
            <p>Select a connected customer from the sidebar to view their live session and reply in real time.</p>
          </div>
        </div>

        <form id="admin-chat-form" class="chat-input-area" style="display: none;">
          <input
            type="text"
            id="admin-chat-input"
            placeholder="Type your support reply as OrbitRush Concierge..."
            autocomplete="off"
            required
          />
          <button type="submit">
            <i class="fas fa-paper-plane"></i>
            <span>Send Reply</span>
          </button>
        </form>
      </section>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      (function () {
        const socket = io({
          transports: ["websocket", "polling"],
          timeout: 2000,
        });
        const roomsListEl = document.getElementById("rooms-list");
        const roomCountBadge = document.getElementById("room-count-badge");
        const messagesEl = document.getElementById("chat-messages");
        const formEl = document.getElementById("admin-chat-form");
        const inputEl = document.getElementById("admin-chat-input");
        const headerEl = document.getElementById("active-chat-header");
        const userNameEl = document.getElementById("active-user-name");
        const roomIdEl = document.getElementById("active-room-id");
        const statusBadgeEl = document.getElementById("status-badge");

        let activeRoom = null;
        let roomsMap = {}; // roomId -> { name, lastMsg, updatedAt }

        // Join global admin monitoring channel
        socket.emit("join_admin");

        // Received list of connected customer rooms
        socket.on("all_chat_rooms", (rooms) => {
          roomsMap = {};
          if (rooms && Array.isArray(rooms)) {
            rooms.forEach((r) => {
              roomsMap[r._id] = {
                name: r.lastSenderName || 'Traveler',
                lastMsg: r.lastMessage || 'Connected to live chat',
                updatedAt: r.updatedAt,
              };
            });
          }
          renderRoomsList();

          const roomKeys = Object.keys(roomsMap);
          if (roomKeys.length === 0) {
            activeRoom = null;
            headerEl.style.display = "none";
            formEl.style.display = "none";
            messagesEl.innerHTML = '<div style="padding: 3rem 2rem; color: #94a3b8; text-align: center;"><i class="fas fa-comments fa-3x mb-3 opacity-25"></i><p>No active customers connected right now.</p></div>';
          } else if (roomKeys.length > 0 && (!activeRoom || !roomsMap[activeRoom])) {
            selectRoom(roomKeys[0], roomsMap[roomKeys[0]].name);
          } else if (activeRoom && roomsMap[activeRoom]) {
            statusBadgeEl.style.background = "#22c55e";
            statusBadgeEl.innerHTML = '<i class="fas fa-circle me-1" style="font-size: 0.55rem;"></i> Live Connected';
          }
        });

        // Real-time activity in any room
        socket.on("new_room_activity", (msg) => {
          const room = msg.room;
          if (roomsMap[room]) {
            roomsMap[room].lastMsg = msg.message;
            roomsMap[room].updatedAt = msg.createdAt || new Date();
          }

          renderRoomsList();

          if (activeRoom === room) {
            appendMessage(msg);
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        });

        // Received message history for selected room
        socket.on("chat_history", (history) => {
          messagesEl.innerHTML = "";
          if (history && history.length > 0) {
            history.forEach((msg) => appendMessage(msg));
            messagesEl.scrollTop = messagesEl.scrollHeight;
          } else {
            messagesEl.innerHTML = '<div style="text-align: center; color: #94a3b8; padding: 2rem;">No previous message history in this session</div>';
          }
        });

        function selectRoom(room, name) {
          activeRoom = room;
          userNameEl.textContent = name || "Traveler (" + room.substring(0, 8) + ")";
          roomIdEl.textContent = `Session Room ID: ${room}`;
          headerEl.style.display = "flex";
          formEl.style.display = "flex";

          if (roomsMap[room]) {
            statusBadgeEl.style.background = "#22c55e";
            statusBadgeEl.innerHTML = '<i class="fas fa-circle me-1" style="font-size: 0.55rem;"></i> Live Connected';
          }

          socket.emit("join_room", {
            room: room,
            user: { fullName: "Support Admin", role: "ADMIN" },
          });

          renderRoomsList();
        }

        function renderRoomsList() {
          roomsListEl.innerHTML = "";
          const keys = Object.keys(roomsMap);
          roomCountBadge.textContent = keys.length;

          if (keys.length === 0) {
            roomsListEl.innerHTML = '<div style="padding: 2.5rem 1.5rem; color: #94a3b8; text-align: center;"><i class="fas fa-user-slash" style="font-size: 2.2rem; color: #cbd5e1; margin-bottom: 0.8rem;"></i><br>No active travelers currently connected</div>';
            return;
          }

          keys.sort((a, b) => new Date(roomsMap[b].updatedAt || 0) - new Date(roomsMap[a].updatedAt || 0));

          keys.forEach((room) => {
            const data = roomsMap[room];
            const div = document.createElement("div");
            div.className = `room-item ${room === activeRoom ? "active" : ""}`;
            div.innerHTML = `
              <div class="room-info">
                <h5><span class="live-dot"></span> ${escapeHtml(data.name)}</h5>
                <p>${escapeHtml(data.lastMsg)}</p>
              </div>
            `;
            div.addEventListener("click", () => selectRoom(room, data.name));
            roomsListEl.appendChild(div);
          });
        }

        formEl.addEventListener("submit", (e) => {
          e.preventDefault();
          const text = inputEl.value.trim();
          if (!text || !activeRoom) return;

          socket.emit("send_message", {
            room: activeRoom,
            senderId: "<%= locals.user ? locals.user._id : '' %>",
            senderName: "Support Admin",
            senderRole: "ADMIN",
            message: text,
          });

          inputEl.value = "";
        });

        function appendMessage(msg) {
          const isSent = msg.senderRole === "ADMIN";
          const row = document.createElement("div");
          row.className = `message-row ${isSent ? "sent" : "received"}`;

          const timeStr = new Date(msg.createdAt || Date.now()).toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          });

          row.innerHTML = `
            <span class="message-sender">${isSent ? "🎧 Concierge Support" : escapeHtml(msg.senderName)}</span>
            <div class="message-bubble">
              ${escapeHtml(msg.message)}
              <div class="message-time">${timeStr}</div>
            </div>
          `;

          messagesEl.appendChild(row);
        }

        function escapeHtml(text) {
          const div = document.createElement("div");
          div.innerText = text;
          return div.innerHTML;
        }
      })();
    </script>
  </body>
</html>
