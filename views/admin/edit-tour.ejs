<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Edit <%= tour.name %> | Admin Control Panel</title>
    <style>
      .admin-form-page {
        background-color: #f1f5f9;
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      .admin-header-strip {
        background: #0f172a;
        color: white;
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .form-container-admin {
        max-width: 1000px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
      }

      .admin-card-section {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 2.2rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        margin-bottom: 2rem;
      }

      .admin-section-heading {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 0.8rem;
      }

      .admin-section-heading i {
        color: var(--orbit-primary);
      }

      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .orbit-admin-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.4rem;
      }

      .orbit-admin-input, .orbit-admin-select, .orbit-admin-textarea {
        width: 100%;
        padding: 0.85rem 1.1rem;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: var(--orbit-transition);
        font-family: inherit;
        background: #ffffff;
      }

      .orbit-admin-input:focus, .orbit-admin-select:focus, .orbit-admin-textarea:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .btn-add-item {
        background: #f0f9ff;
        color: #0369a1;
        border: 1.5px dashed #0284c7;
        padding: 0.6rem 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.8rem;
      }

      .btn-add-item:hover {
        background: var(--orbit-primary);
        color: white;
      }

      .btn-remove-row {
        background: #fee2e2;
        color: #ef4444;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .dynamic-row {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        align-items: center;
      }

      .dynamic-box-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1.25rem;
        margin-bottom: 1rem;
        position: relative;
      }

      .btn-submit-tour {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border: none;
        width: 100%;
        padding: 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1.15rem;
        cursor: pointer;
        box-shadow: 0 10px 30px rgba(2, 132, 199, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
      }

      .preview-thumb-img {
        width: 120px;
        height: 80px;
        border-radius: 8px;
        object-fit: cover;
        margin-top: 0.5rem;
        border: 1px solid #cbd5e1;
      }

      @media (max-width: 768px) {
        .grid-2, .grid-3 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body class="admin-form-page">
    <header class="admin-header-strip">
      <div class="d-flex align-items-center gap-3">
        <a href="/tour/admin/dashboard" class="btn btn-sm btn-outline-light" style="border-radius: 9999px;">
          <i class="fas fa-arrow-left me-1"></i> Dashboard
        </a>
        <h2 style="font-size: 1.3rem; margin: 0; font-weight: 800; color: white;">Edit Tour: <%= tour.name %></h2>
      </div>
    </header>

    <div class="form-container-admin">
      <form action="/tour/admin/edit/<%= tour._id %>" method="POST" enctype="multipart/form-data">
        <!-- Basic Info -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-info-circle"></i> Basic Tour Information
          </h3>

          <div class="grid-2 mb-3">
            <div>
              <label for="name" class="orbit-admin-label">Tour Title *</label>
              <input type="text" id="name" name="name" class="orbit-admin-input" value="<%= tour.name %>" required />
            </div>
            <div>
              <label for="location" class="orbit-admin-label">Destination Location *</label>
              <input type="text" id="location" name="location" class="orbit-admin-input" value="<%= tour.location %>" required />
            </div>
          </div>

          <div class="grid-3 mb-3">
            <div>
              <label for="price" class="orbit-admin-label">Price Per Traveler (INR) *</label>
              <input type="number" id="price" name="price" class="orbit-admin-input" value="<%= tour.price %>" min="0" required />
            </div>
            <div>
              <label for="duration" class="orbit-admin-label">Duration *</label>
              <input type="text" id="duration" name="duration" class="orbit-admin-input" value="<%= tour.duration %>" required />
            </div>
            <div>
              <label for="maxGroupSize" class="orbit-admin-label">Max Group Size</label>
              <input type="number" id="maxGroupSize" name="maxGroupSize" class="orbit-admin-input" value="<%= tour.maxGroupSize || 20 %>" min="1" />
            </div>
          </div>

          <div class="grid-2 mb-3">
            <div>
              <label for="difficulty" class="orbit-admin-label">Difficulty Rating</label>
              <select id="difficulty" name="difficulty" class="orbit-admin-select">
                <option value="Easy" <%= tour.difficulty === 'Easy' ? 'selected' : '' %>>Easy</option>
                <option value="Moderate" <%= tour.difficulty === 'Moderate' ? 'selected' : '' %>>Moderate</option>
                <option value="Challenging" <%= tour.difficulty === 'Challenging' ? 'selected' : '' %>>Challenging</option>
                <option value="Difficult" <%= tour.difficulty === 'Difficult' ? 'selected' : '' %>>Difficult</option>
              </select>
            </div>
            <div>
              <label for="startLocation" class="orbit-admin-label">Starting Departure Point</label>
              <input type="text" id="startLocation" name="startLocation" class="orbit-admin-input" value="<%= tour.startLocation || '' %>" />
            </div>
          </div>

          <div>
            <label for="overview" class="orbit-admin-label">Expedition Overview *</label>
            <textarea id="overview" name="overview" class="orbit-admin-textarea" rows="4" required><%= tour.overview %></textarea>
          </div>
        </div>

        <!-- Imagery -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-camera"></i> Imagery & Media
          </h3>

          <div class="grid-2">
            <div>
              <label for="coverImage" class="orbit-admin-label">Update Cover Image</label>
              <input type="file" id="coverImage" name="coverImage" class="orbit-admin-input" accept="image/*" />
              <% if (tour.coverImage) { %>
                <div>
                  <small class="text-muted d-block mt-1">Current Cover Image:</small>
                  <img src="<%= tour.coverImage %>" alt="Current Cover" class="preview-thumb-img" />
                </div>
              <% } %>
            </div>

            <div>
              <label for="moreImages" class="orbit-admin-label">Add / Replace Gallery Images</label>
              <input type="file" id="moreImages" name="moreImages" class="orbit-admin-input" accept="image/*" multiple />
              <% if (tour.moreImages && tour.moreImages.length > 0) { %>
                <div class="d-flex gap-2 flex-wrap mt-2">
                  <% tour.moreImages.forEach(img => { %>
                    <img src="<%= img %>" alt="Gallery preview" class="preview-thumb-img" style="width: 70px; height: 50px;" />
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Departure Dates -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-calendar-alt"></i> Scheduled Departure Dates
          </h3>
          <div id="availableDatesContainer">
            <% if (tour.availableDates && tour.availableDates.length > 0) { %>
              <% tour.availableDates.forEach(date => { 
                const dateVal = new Date(date).toISOString().split('T')[0];
              %>
                <div class="dynamic-row">
                  <input type="date" name="availableDates[]" value="<%= dateVal %>" class="orbit-admin-input date-input" />
                  <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" class="btn-add-item" onclick="addDateField()">
            <i class="fas fa-plus"></i> Add Departure Date
          </button>
        </div>

        <!-- Highlights -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-sparkles"></i> Expedition Highlights
          </h3>
          <div id="highlightsContainer">
            <% if (tour.highlights && tour.highlights.length > 0) { %>
              <% tour.highlights.forEach(highlight => { %>
                <div class="dynamic-row">
                  <input type="text" name="highlights[]" value="<%= highlight %>" class="orbit-admin-input highlight-input" />
                  <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" class="btn-add-item" onclick="addHighlightField()">
            <i class="fas fa-plus"></i> Add Highlight
          </button>
        </div>

        <!-- Day-by-Day Itinerary -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-route"></i> Day-by-Day Itinerary
          </h3>
          <div id="itineraryContainer">
            <% if (tour.itinerary && tour.itinerary.length > 0) { %>
              <% tour.itinerary.forEach((item, index) => { %>
                <div class="dynamic-box-card itinerary-item">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong style="color: var(--orbit-primary);">Day <%= item.day || (index + 1) %></strong>
                    <button type="button" class="btn-remove-row" onclick="this.closest('.itinerary-item').remove()"><i class="fas fa-trash"></i></button>
                  </div>
                  <input type="hidden" name="itinerary[<%= index %>][day]" value="<%= item.day || (index + 1) %>" />
                  <div class="mb-2">
                    <input type="text" name="itinerary[<%= index %>][title]" value="<%= item.title %>" class="orbit-admin-input mb-2" placeholder="Day Title" />
                    <textarea name="itinerary[<%= index %>][description]" class="orbit-admin-textarea" rows="2" placeholder="Activities..."><%= item.description %></textarea>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" class="btn-add-item" onclick="addItineraryDay()">
            <i class="fas fa-plus"></i> Add Day to Itinerary
          </button>
        </div>

        <!-- Inclusions & Exclusions -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-clipboard-check"></i> Inclusions & Exclusions
          </h3>

          <div class="grid-2">
            <div>
              <label class="orbit-admin-label" style="color: #10b981;">Included Services</label>
              <div id="includedContainer">
                <% if (tour.included && tour.included.length > 0) { %>
                  <% tour.included.forEach(inc => { %>
                    <div class="dynamic-row">
                      <input type="text" name="included[]" value="<%= inc %>" class="orbit-admin-input included-input" />
                      <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                    </div>
                  <% }) %>
                <% } %>
              </div>
              <button type="button" class="btn-add-item" onclick="addIncludedField()">
                <i class="fas fa-plus"></i> Add Inclusion
              </button>
            </div>

            <div>
              <label class="orbit-admin-label" style="color: #ef4444;">Excluded Services</label>
              <div id="excludedContainer">
                <% if (tour.excluded && tour.excluded.length > 0) { %>
                  <% tour.excluded.forEach(exc => { %>
                    <div class="dynamic-row">
                      <input type="text" name="excluded[]" value="<%= exc %>" class="orbit-admin-input excluded-input" />
                      <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                    </div>
                  <% }) %>
                <% } %>
              </div>
              <button type="button" class="btn-add-item" onclick="addExcludedField()">
                <i class="fas fa-plus"></i> Add Exclusion
              </button>
            </div>
          </div>
        </div>

        <!-- Guides -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-user-tie"></i> Assigned Guides & Naturalists
          </h3>
          <div id="guidesContainer">
            <% if (tour.guides && tour.guides.length > 0) { %>
              <% tour.guides.forEach((guide, index) => { %>
                <div class="dynamic-row guide-item">
                  <input type="text" name="guides[<%= index %>][name]" value="<%= guide.name %>" class="orbit-admin-input" placeholder="Guide Name" />
                  <input type="text" name="guides[<%= index %>][role]" value="<%= guide.role %>" class="orbit-admin-input" placeholder="Role" />
                  <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" class="btn-add-item" onclick="addGuide()">
            <i class="fas fa-plus"></i> Add Guide
          </button>
        </div>

        <!-- Restrictions -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-shield-alt"></i> Restrictions & Policies
          </h3>
          <div>
            <label for="ageRestriction" class="orbit-admin-label">Age Restriction (Min Age)</label>
            <input type="number" id="ageRestriction" name="ageRestriction" value="<%= tour.ageRestriction || '' %>" class="orbit-admin-input" min="0" />
          </div>
        </div>

        <button type="submit" class="btn-submit-tour">
          <i class="fas fa-save"></i>
          <span>Save Changes to Expedition</span>
        </button>
      </form>
    </div>

    <%- include("../partials/scripts") %>

    <script>
      function addDateField() {
        const container = document.getElementById("availableDatesContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="date" name="availableDates[]" class="orbit-admin-input date-input" />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addHighlightField() {
        const container = document.getElementById("highlightsContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="text" name="highlights[]" class="orbit-admin-input highlight-input" placeholder="Highlight..." />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addItineraryDay() {
        const container = document.getElementById("itineraryContainer");
        const count = container.querySelectorAll(".itinerary-item").length;
        const dayNum = count + 1;
        const card = document.createElement("div");
        card.className = "dynamic-box-card itinerary-item";
        card.innerHTML = `
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong style="color: var(--orbit-primary);">Day ${dayNum}</strong>
            <button type="button" class="btn-remove-row" onclick="this.closest('.itinerary-item').remove()"><i class="fas fa-trash"></i></button>
          </div>
          <input type="hidden" name="itinerary[${count}][day]" value="${dayNum}" />
          <div class="mb-2">
            <input type="text" name="itinerary[${count}][title]" class="orbit-admin-input mb-2" placeholder="Day Title" />
            <textarea name="itinerary[${count}][description]" class="orbit-admin-textarea" rows="2" placeholder="Activities..."></textarea>
          </div>
        `;
        container.appendChild(card);
      }

      function addIncludedField() {
        const container = document.getElementById("includedContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="text" name="included[]" class="orbit-admin-input included-input" placeholder="Included item..." />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addExcludedField() {
        const container = document.getElementById("excludedContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="text" name="excluded[]" class="orbit-admin-input excluded-input" placeholder="Excluded item..." />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addGuide() {
        const container = document.getElementById("guidesContainer");
        const count = container.querySelectorAll(".guide-item").length;
        const row = document.createElement("div");
        row.className = "dynamic-row guide-item";
        row.innerHTML = `
          <input type="text" name="guides[${count}][name]" class="orbit-admin-input" placeholder="Guide Name" />
          <input type="text" name="guides[${count}][role]" class="orbit-admin-input" placeholder="Role" />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }
    </script>
  </body>
</html>
