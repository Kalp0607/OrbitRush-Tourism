<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Create New Expedition | Admin Control Panel</title>
    <style>
      .admin-form-page {
        background-color: #f1f5f9;
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      .admin-header-strip {
        background: #0f172a;
        color: white;
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .form-container-admin {
        max-width: 1000px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
      }

      .admin-card-section {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 2.2rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        margin-bottom: 2rem;
      }

      .admin-section-heading {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 0.8rem;
      }

      .admin-section-heading i {
        color: var(--orbit-primary);
      }

      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .orbit-admin-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.4rem;
      }

      .orbit-admin-input, .orbit-admin-select, .orbit-admin-textarea {
        width: 100%;
        padding: 0.85rem 1.1rem;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: var(--orbit-transition);
        font-family: inherit;
        background: #ffffff;
      }

      .orbit-admin-input:focus, .orbit-admin-select:focus, .orbit-admin-textarea:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .btn-add-item {
        background: #f0f9ff;
        color: #0369a1;
        border: 1.5px dashed #0284c7;
        padding: 0.6rem 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.8rem;
      }

      .btn-add-item:hover {
        background: var(--orbit-primary);
        color: white;
      }

      .btn-remove-row {
        background: #fee2e2;
        color: #ef4444;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .dynamic-row {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        align-items: center;
      }

      .dynamic-box-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1.25rem;
        margin-bottom: 1rem;
        position: relative;
      }

      .btn-submit-tour {
        background: linear-gradient(135deg, var(--orbit-accent), var(--orbit-accent-hover));
        color: white;
        border: none;
        width: 100%;
        padding: 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1.15rem;
        cursor: pointer;
        box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
      }

      @media (max-width: 768px) {
        .grid-2, .grid-3 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body class="admin-form-page">
    <header class="admin-header-strip">
      <div class="d-flex align-items-center gap-3">
        <a href="/tour/admin/dashboard" class="btn btn-sm btn-outline-light" style="border-radius: 9999px;">
          <i class="fas fa-arrow-left me-1"></i> Dashboard
        </a>
        <h2 style="font-size: 1.3rem; margin: 0; font-weight: 800; color: white;">Create New Expedition</h2>
      </div>
    </header>

    <div class="form-container-admin">
      <% if (locals.error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: var(--orbit-radius-md); font-weight: 600; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.15);">
          <i class="fas fa-exclamation-triangle me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <form action="/tour/admin/create" method="POST" enctype="multipart/form-data">
        <!-- Core Details -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-info-circle"></i> Basic Tour Information
          </h3>

          <div class="grid-2 mb-3">
            <div>
              <label for="name" class="orbit-admin-label">Tour Title *</label>
              <input type="text" id="name" name="name" class="orbit-admin-input" placeholder="e.g. Majestic Ladakh Expedition" required />
            </div>
            <div>
              <label for="location" class="orbit-admin-label">Destination Location *</label>
              <input type="text" id="location" name="location" class="orbit-admin-input" placeholder="e.g. Leh-Ladakh, India" required />
            </div>
          </div>

          <div class="grid-3 mb-3">
            <div>
              <label for="price" class="orbit-admin-label">Price Per Traveler (INR) *</label>
              <input type="number" id="price" name="price" class="orbit-admin-input" placeholder="e.g. 45000" min="0" required />
            </div>
            <div>
              <label for="duration" class="orbit-admin-label">Duration *</label>
              <input type="text" id="duration" name="duration" class="orbit-admin-input" placeholder="e.g. 7 Days / 6 Nights" required />
            </div>
            <div>
              <label for="maxGroupSize" class="orbit-admin-label">Max Group Size</label>
              <input type="number" id="maxGroupSize" name="maxGroupSize" class="orbit-admin-input" placeholder="20" min="1" />
            </div>
          </div>

          <div class="grid-2 mb-3">
            <div>
              <label for="difficulty" class="orbit-admin-label">Difficulty Rating</label>
              <select id="difficulty" name="difficulty" class="orbit-admin-select">
                <option value="Easy">Easy</option>
                <option value="Moderate" selected>Moderate</option>
                <option value="Challenging">Challenging</option>
                <option value="Difficult">Difficult</option>
              </select>
            </div>
            <div>
              <label for="startLocation" class="orbit-admin-label">Starting Departure Point</label>
              <input type="text" id="startLocation" name="startLocation" class="orbit-admin-input" placeholder="e.g. Leh Airport / Delhi" />
            </div>
          </div>

          <div>
            <label for="overview" class="orbit-admin-label">Expedition Overview / Story *</label>
            <textarea id="overview" name="overview" class="orbit-admin-textarea" rows="4" placeholder="Detailed storytelling description of the tour..." required></textarea>
          </div>
        </div>

        <!-- Imagery Uploads -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-camera"></i> Imagery & Media
          </h3>

          <div class="grid-2">
            <div>
              <label for="coverImage" class="orbit-admin-label">Cover Image *</label>
              <input type="file" id="coverImage" name="coverImage" class="orbit-admin-input" accept="image/*" required />
              <small class="text-muted">Primary high-resolution landscape banner</small>
            </div>

            <div>
              <label for="moreImages" class="orbit-admin-label">Gallery Images (Multiple)</label>
              <input type="file" id="moreImages" name="moreImages" class="orbit-admin-input" accept="image/*" multiple />
              <small class="text-muted">Upload gallery photos for destination carousel</small>
            </div>
          </div>
        </div>

        <!-- Departure Dates -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-calendar-alt"></i> Scheduled Departure Dates
          </h3>
          <div id="availableDatesContainer">
            <div class="dynamic-row">
              <input type="date" name="availableDates[]" class="orbit-admin-input date-input" />
              <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <button type="button" class="btn-add-item" onclick="addDateField()">
            <i class="fas fa-plus"></i> Add Departure Date
          </button>
        </div>

        <!-- Highlights -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-sparkles"></i> Expedition Highlights
          </h3>
          <div id="highlightsContainer">
            <div class="dynamic-row">
              <input type="text" name="highlights[]" class="orbit-admin-input highlight-input" placeholder="e.g. Pangong Tso Lake Camping under Milky Way" />
              <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <button type="button" class="btn-add-item" onclick="addHighlightField()">
            <i class="fas fa-plus"></i> Add Highlight
          </button>
        </div>

        <!-- Day-by-Day Itinerary -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-route"></i> Day-by-Day Itinerary
          </h3>
          <div id="itineraryContainer">
            <div class="dynamic-box-card itinerary-item">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <strong style="color: var(--orbit-primary);">Day 1</strong>
                <button type="button" class="btn-remove-row" onclick="this.closest('.itinerary-item').remove()"><i class="fas fa-trash"></i></button>
              </div>
              <input type="hidden" name="itinerary[0][day]" value="1" />
              <div class="mb-2">
                <input type="text" name="itinerary[0][title]" class="orbit-admin-input mb-2" placeholder="Day Title (e.g. Arrival & Acclimatization in Leh)" />
                <textarea name="itinerary[0][description]" class="orbit-admin-textarea" rows="2" placeholder="Description of daily activities, meals, and accommodations..."></textarea>
              </div>
            </div>
          </div>
          <button type="button" class="btn-add-item" onclick="addItineraryDay()">
            <i class="fas fa-plus"></i> Add Day to Itinerary
          </button>
        </div>

        <!-- Inclusions & Exclusions -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-clipboard-check"></i> Inclusions & Exclusions
          </h3>

          <div class="grid-2">
            <div>
              <label class="orbit-admin-label" style="color: #10b981;">Included Services</label>
              <div id="includedContainer">
                <div class="dynamic-row">
                  <input type="text" name="included[]" class="orbit-admin-input included-input" placeholder="e.g. 5-Star Eco Lodge Stays" />
                  <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <button type="button" class="btn-add-item" onclick="addIncludedField()">
                <i class="fas fa-plus"></i> Add Inclusion
              </button>
            </div>

            <div>
              <label class="orbit-admin-label" style="color: #ef4444;">Excluded Services</label>
              <div id="excludedContainer">
                <div class="dynamic-row">
                  <input type="text" name="excluded[]" class="orbit-admin-input excluded-input" placeholder="e.g. International Flights" />
                  <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <button type="button" class="btn-add-item" onclick="addExcludedField()">
                <i class="fas fa-plus"></i> Add Exclusion
              </button>
            </div>
          </div>
        </div>

        <!-- Guides -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-user-tie"></i> Assigned Guides & Naturalists
          </h3>
          <div id="guidesContainer">
            <div class="dynamic-row guide-item">
              <input type="text" name="guides[0][name]" class="orbit-admin-input" placeholder="Guide Full Name" />
              <input type="text" name="guides[0][role]" class="orbit-admin-input" placeholder="Role (e.g. Senior Mountain Guide)" />
              <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <button type="button" class="btn-add-item" onclick="addGuide()">
            <i class="fas fa-plus"></i> Add Guide
          </button>
        </div>

        <!-- Age Restriction & Policies -->
        <div class="admin-card-section">
          <h3 class="admin-section-heading">
            <i class="fas fa-shield-alt"></i> Restrictions & Policies
          </h3>
          <div>
            <label for="ageRestriction" class="orbit-admin-label">Age Restriction (Min Age)</label>
            <input type="number" id="ageRestriction" name="ageRestriction" class="orbit-admin-input" placeholder="e.g. 12" min="0" />
          </div>
        </div>

        <button type="submit" class="btn-submit-tour">
          <i class="fas fa-check-circle"></i>
          <span>Publish & Launch Expedition</span>
        </button>
      </form>
    </div>

    <%- include("../partials/scripts") %>

    <script>
      function addDateField() {
        const container = document.getElementById("availableDatesContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="date" name="availableDates[]" class="orbit-admin-input date-input" />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addHighlightField() {
        const container = document.getElementById("highlightsContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="text" name="highlights[]" class="orbit-admin-input highlight-input" placeholder="Expedition highlight..." />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addItineraryDay() {
        const container = document.getElementById("itineraryContainer");
        const count = container.querySelectorAll(".itinerary-item").length;
        const dayNum = count + 1;
        const card = document.createElement("div");
        card.className = "dynamic-box-card itinerary-item";
        card.innerHTML = `
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong style="color: var(--orbit-primary);">Day ${dayNum}</strong>
            <button type="button" class="btn-remove-row" onclick="this.closest('.itinerary-item').remove()"><i class="fas fa-trash"></i></button>
          </div>
          <input type="hidden" name="itinerary[${count}][day]" value="${dayNum}" />
          <div class="mb-2">
            <input type="text" name="itinerary[${count}][title]" class="orbit-admin-input mb-2" placeholder="Day Title" />
            <textarea name="itinerary[${count}][description]" class="orbit-admin-textarea" rows="2" placeholder="Description of activities..."></textarea>
          </div>
        `;
        container.appendChild(card);
      }

      function addIncludedField() {
        const container = document.getElementById("includedContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="text" name="included[]" class="orbit-admin-input included-input" placeholder="Included item..." />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addExcludedField() {
        const container = document.getElementById("excludedContainer");
        const row = document.createElement("div");
        row.className = "dynamic-row";
        row.innerHTML = `
          <input type="text" name="excluded[]" class="orbit-admin-input excluded-input" placeholder="Excluded item..." />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }

      function addGuide() {
        const container = document.getElementById("guidesContainer");
        const count = container.querySelectorAll(".guide-item").length;
        const row = document.createElement("div");
        row.className = "dynamic-row guide-item";
        row.innerHTML = `
          <input type="text" name="guides[${count}][name]" class="orbit-admin-input" placeholder="Guide Full Name" />
          <input type="text" name="guides[${count}][role]" class="orbit-admin-input" placeholder="Role" />
          <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
      }
    </script>
  </body>
</html>
