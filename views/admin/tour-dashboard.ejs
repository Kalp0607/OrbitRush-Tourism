<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Expeditions Management | Admin Control Center</title>
    <style>
      .admin-layout {
        background-color: #f1f5f9;
        min-height: 100vh;
        padding-bottom: 5rem;
      }

      /* Admin Top Bar */
      .admin-topbar {
        background: #0f172a;
        color: white;
        padding: 1.25rem 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }

      .admin-nav-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .admin-nav-btn {
        color: #cbd5e1;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.88rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: var(--orbit-transition);
      }

      .admin-nav-btn:hover, .admin-nav-btn.active {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
      }

      .admin-nav-btn.active {
        background: var(--orbit-primary);
      }

      /* Dashboard Main Content */
      .dashboard-body {
        max-width: 1320px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
      }

      /* Stat Cards Grid */
      .stats-grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .stat-card-admin {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 1.8rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: var(--orbit-transition);
      }

      .stat-card-admin:hover {
        transform: translateY(-4px);
        box-shadow: var(--orbit-shadow-md);
      }

      .stat-admin-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
      }

      .stat-admin-val {
        font-size: 2.2rem;
        font-weight: 900;
        color: var(--orbit-dark);
        line-height: 1;
      }

      .stat-icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
      }

      /* Admin Content Card */
      .admin-table-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        overflow: hidden;
      }

      .table-card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .table-card-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin: 0;
      }

      .admin-table {
        width: 100%;
        border-collapse: collapse;
      }

      .admin-table th {
        background: #f8fafc;
        padding: 1rem 1.5rem;
        font-size: 0.78rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
      }

      .admin-table td {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        font-size: 0.92rem;
      }

      .admin-table tr:hover td {
        background: #f8fafc;
      }

      .tour-thumb-img {
        width: 60px;
        height: 45px;
        border-radius: 8px;
        object-fit: cover;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      }

      .action-btn-group {
        display: flex;
        gap: 0.5rem;
      }

      .btn-action-sm {
        padding: 0.45rem 0.85rem;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border: none;
        cursor: pointer;
        transition: var(--orbit-transition);
      }

      .btn-action-view {
        background: #e0f2fe;
        color: #0369a1;
      }
      .btn-action-view:hover { background: #bae6fd; color: #0284c7; }

      .btn-action-edit {
        background: #fef3c7;
        color: #92400e;
      }
      .btn-action-edit:hover { background: #fde68a; color: #78350f; }

      .btn-action-delete {
        background: #fee2e2;
        color: #991b1b;
      }
      .btn-action-delete:hover { background: #fecaca; color: #7f1d1d; }

      @media (max-width: 991px) {
        .stats-grid-4 {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 600px) {
        .stats-grid-4 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body class="admin-layout">
    <!-- Admin Top Navbar -->
    <header class="admin-topbar">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <a href="/" class="d-flex align-items-center gap-2 text-white text-decoration-none">
            <img src="/images/1760177356614.png" alt="OrbitRush" style="width: 34px; height: 34px; border-radius: 8px;" />
            <span style="font-family: var(--orbit-font-heading); font-weight: 800; font-size: 1.25rem;">OrbitRush Admin</span>
          </a>
        </div>

        <nav class="admin-nav-links">
          <a href="/tour/admin/dashboard" class="admin-nav-btn active">
            <i class="fas fa-mountain"></i> Tours
          </a>
          <a href="/booking/admin/bookings" class="admin-nav-btn">
            <i class="fas fa-calendar-check"></i> Bookings
          </a>
          <a href="/tour/admin/dashboard/enquiries-details" class="admin-nav-btn">
            <i class="fas fa-clipboard-list"></i> Inquiries
          </a>
          <a href="/tour/admin/dashboard/custom-enquiries" class="admin-nav-btn">
            <i class="fas fa-magic"></i> AI Trips
          </a>
          <a href="/tour/admin/chat" class="admin-nav-btn">
            <i class="fas fa-comments"></i> Live Chat
          </a>
          <a href="/tour/admin/dashboard/user-details" class="admin-nav-btn">
            <i class="fas fa-users"></i> Users
          </a>
          <a href="/" class="admin-nav-btn" style="background: rgba(255,255,255,0.08);">
            <i class="fas fa-external-link-alt"></i> View Site
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Dashboard Area -->
    <main class="dashboard-body">
      <!-- 4 Stat Counters -->
      <div class="stats-grid-4">
        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">Total Tours</div>
            <div class="stat-admin-val"><%= (locals.tours && locals.tours.length) || 0 %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #e0f2fe; color: #0284c7;">
            <i class="fas fa-map-marked-alt"></i>
          </div>
        </div>

        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">Registered Users</div>
            <div class="stat-admin-val"><%= locals.totalUsers != null ? locals.totalUsers : 0 %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #dcfce7; color: #16a34a;">
            <i class="fas fa-users"></i>
          </div>
        </div>

        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">Standard Inquiries</div>
            <div class="stat-admin-val"><%= locals.totalEnquiries != null ? locals.totalEnquiries : 0 %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #fef3c7; color: #d97706;">
            <i class="fas fa-paper-plane"></i>
          </div>
        </div>

        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">AI Custom Trips</div>
            <div class="stat-admin-val"><%= locals.totalCustomEnquiries != null ? locals.totalCustomEnquiries : 0 %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #ede9fe; color: #7c3aed;">
            <i class="fas fa-sparkles"></i>
          </div>
        </div>
      </div>

      <!-- Tours Management Table Card -->
      <div class="admin-table-card">
        <div class="table-card-header">
          <div>
            <h2 class="table-card-title">Expeditions Portfolio</h2>
            <small class="text-muted">Manage active itineraries, pricing, and destination details</small>
          </div>
          <a href="/tour/admin/create" class="btn-orbit-hero btn-orbit-primary" style="padding: 0.65rem 1.4rem; font-size: 0.9rem;">
            <i class="fas fa-plus"></i> Create New Tour
          </a>
        </div>

        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Tour</th>
                <th>Location</th>
                <th>Price (INR)</th>
                <th>Duration</th>
                <th>Rating</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (tours && tours.length > 0) { %>
                <% tours.forEach(tour => { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img
                          src="<%= tour.coverImage || '/images/default-tour.jpg' %>"
                          alt="<%= tour.name %>"
                          class="tour-thumb-img"
                        />
                        <span style="font-weight: 800; color: var(--orbit-dark);"><%= tour.name %></span>
                      </div>
                    </td>
                    <td>
                      <i class="fas fa-map-marker-alt text-primary me-1"></i>
                      <%= tour.location %>
                    </td>
                    <td>
                      <strong style="color: #10b981;">₹<%= (tour.price != null ? tour.price : 0).toLocaleString('en-IN') %></strong>
                    </td>
                    <td><%= tour.duration %></td>
                    <td>
                      <span class="badge bg-warning text-dark" style="font-weight: 700;">
                        ★ <%= tour.ratingsAverage || '4.9' %>
                      </span>
                    </td>
                    <td style="text-align: right;">
                      <div class="action-btn-group justify-content-end">
                        <a
                          href="/tour/<%= tour.name.replace(/\s+/g, '-').toLowerCase() %>"
                          class="btn-action-sm btn-action-view"
                          target="_blank"
                          title="View Live Tour"
                        >
                          <i class="fas fa-eye"></i> View
                        </a>
                        <a
                          href="/tour/admin/edit/<%= tour._id %>"
                          class="btn-action-sm btn-action-edit"
                          title="Edit Tour"
                        >
                          <i class="fas fa-edit"></i> Edit
                        </a>
                        <button
                          class="btn-action-sm btn-action-delete"
                          onclick="deleteTour('<%= tour.name.replace(/\s+/g, '-').toLowerCase() %>')"
                          title="Delete Tour"
                        >
                          <i class="fas fa-trash-alt"></i> Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-5 text-muted">
                    <i class="fas fa-map-signs fa-3x mb-3 opacity-50"></i>
                    <p>No tours created yet. Click "+ Create New Tour" to begin.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include("../partials/scripts") %>

    <script>
      async function deleteTour(slug) {
        if (!confirm("Are you sure you want to permanently delete this expedition?")) {
          return;
        }

        try {
          const response = await fetch(`/tour/${slug}`, {
            method: "DELETE",
          });

          const data = await response.json();

          if (data.success) {
            alert("✅ " + data.message);
            window.location.reload();
          } else {
            alert("❌ " + (data.message || "Failed to delete tour"));
          }
        } catch (error) {
          console.error("Error deleting tour:", error);
          alert("❌ Something went wrong while deleting the tour.");
        }
      }
    </script>
  </body>
</html>
