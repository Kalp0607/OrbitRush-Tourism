<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Users Directory | Admin Control Panel</title>
    <style>
      .admin-layout {
        background-color: #f1f5f9;
        min-height: 100vh;
        padding-bottom: 5rem;
      }

      .admin-topbar {
        background: #0f172a;
        color: white;
        padding: 1.25rem 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }

      .admin-nav-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .admin-nav-btn {
        color: #cbd5e1;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.88rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: var(--orbit-transition);
      }

      .admin-nav-btn:hover, .admin-nav-btn.active {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
      }

      .admin-nav-btn.active {
        background: var(--orbit-primary);
      }

      .dashboard-body {
        max-width: 1200px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
      }

      .admin-table-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        overflow: hidden;
      }

      .table-card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .admin-table {
        width: 100%;
        border-collapse: collapse;
      }

      .admin-table th {
        background: #f8fafc;
        padding: 1rem 1.5rem;
        font-size: 0.78rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
      }

      .admin-table td {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        font-size: 0.92rem;
      }

      .admin-table tr:hover td {
        background: #f8fafc;
      }

      .user-avatar-cell {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      }
    </style>
  </head>

  <body class="admin-layout">
    <header class="admin-topbar">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
          <img src="/images/1760177356614.png" alt="OrbitRush" style="width: 34px; height: 34px; border-radius: 8px;" />
          <span style="font-family: var(--orbit-font-heading); font-weight: 800; font-size: 1.25rem;">OrbitRush Admin</span>
        </div>

        <nav class="admin-nav-links">
          <a href="/tour/admin/dashboard" class="admin-nav-btn">
            <i class="fas fa-mountain"></i> Tours
          </a>
          <a href="/booking/admin/bookings" class="admin-nav-btn">
            <i class="fas fa-calendar-check"></i> Bookings
          </a>
          <a href="/tour/admin/dashboard/enquiries-details" class="admin-nav-btn">
            <i class="fas fa-clipboard-list"></i> Inquiries
          </a>
          <a href="/tour/admin/dashboard/custom-enquiries" class="admin-nav-btn">
            <i class="fas fa-magic"></i> AI Trips
          </a>
          <a href="/tour/admin/chat" class="admin-nav-btn">
            <i class="fas fa-comments"></i> Live Chat
          </a>
          <a href="/tour/admin/dashboard/user-details" class="admin-nav-btn active">
            <i class="fas fa-users"></i> Users
          </a>
          <a href="/" class="admin-nav-btn" style="background: rgba(255,255,255,0.08);">
            <i class="fas fa-external-link-alt"></i> View Site
          </a>
        </nav>
      </div>
    </header>

    <main class="dashboard-body">
      <div class="admin-table-card">
        <div class="table-card-header">
          <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--orbit-dark); margin: 0;">Registered Explorers Directory</h2>
            <small class="text-muted">Total Accounts: <%= users ? users.length : 0 %></small>
          </div>
        </div>

        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Explorer</th>
                <th>Email Address</th>
                <th>Role</th>
                <th>Member Since</th>
              </tr>
            </thead>
            <tbody>
              <% if (users && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img
                          src="<%= u.profileImageURL || '/images/default-avatar.png' %>"
                          alt="<%= u.fullName %>"
                          class="user-avatar-cell"
                          onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.fullName) %>&background=0284c7&color=fff'"
                        />
                        <span style="font-weight: 800; color: var(--orbit-dark);"><%= u.fullName %></span>
                      </div>
                    </td>
                    <td>
                      <a href="mailto:<%= u.email %>" style="color: var(--orbit-primary); text-decoration: none; font-weight: 600;">
                        <%= u.email %>
                      </a>
                    </td>
                    <td>
                      <% if (u.role === 'ADMIN') { %>
                        <span class="badge bg-danger px-2 py-1" style="font-weight: 700;">ADMIN</span>
                      <% } else { %>
                        <span class="badge bg-secondary px-2 py-1" style="font-weight: 600;">NORMAL</span>
                      <% } %>
                    </td>
                    <td>
                      <%= new Date(u.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center py-5 text-muted">
                    <i class="fas fa-users fa-3x mb-3 opacity-50"></i>
                    <p>No users registered yet.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include("../partials/scripts") %>
  </body>
</html>
