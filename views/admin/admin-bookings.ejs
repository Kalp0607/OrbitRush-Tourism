<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>All Bookings | Admin Control Center</title>
    <style>
      .admin-layout {
        background-color: #f1f5f9;
        min-height: 100vh;
        padding-bottom: 5rem;
      }

      .admin-topbar {
        background: #0f172a;
        color: white;
        padding: 1.25rem 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }

      .admin-nav-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .admin-nav-btn {
        color: #cbd5e1;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.88rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: var(--orbit-transition);
      }

      .admin-nav-btn:hover, .admin-nav-btn.active {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
      }

      .admin-nav-btn.active {
        background: var(--orbit-primary);
      }

      .dashboard-body {
        max-width: 1380px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
      }

      .stats-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .stat-card-admin {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 1.8rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .stat-admin-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
      }

      .stat-admin-val {
        font-size: 2.2rem;
        font-weight: 900;
        color: var(--orbit-dark);
        line-height: 1;
      }

      .stat-icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
      }

      .admin-table-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        overflow: hidden;
      }

      .table-card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .admin-table {
        width: 100%;
        border-collapse: collapse;
      }

      .admin-table th {
        background: #f8fafc;
        padding: 1rem 1.2rem;
        font-size: 0.78rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
      }

      .admin-table td {
        padding: 1.2rem 1.2rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: top;
        font-size: 0.9rem;
      }

      .admin-table tr:hover td {
        background: #f8fafc;
      }

      .status-pill-sm {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.25rem 0.65rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .status-pill-sm.confirmed {
        background: #dcfce7;
        color: #166534;
      }

      .status-pill-sm.cancelled {
        background: #fee2e2;
        color: #991b1b;
      }

      .traveler-mini-pill {
        background: #f1f5f9;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-size: 0.78rem;
        margin-bottom: 0.25rem;
        display: block;
      }

      @media (max-width: 991px) {
        .stats-grid-3 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body class="admin-layout">
    <header class="admin-topbar">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
          <img src="/images/1760177356614.png" alt="OrbitRush" style="width: 34px; height: 34px; border-radius: 8px;" />
          <span style="font-family: var(--orbit-font-heading); font-weight: 800; font-size: 1.25rem;">OrbitRush Admin</span>
        </div>

        <nav class="admin-nav-links">
          <a href="/tour/admin/dashboard" class="admin-nav-btn">
            <i class="fas fa-mountain"></i> Tours
          </a>
          <a href="/booking/admin/bookings" class="admin-nav-btn active">
            <i class="fas fa-calendar-check"></i> Bookings
          </a>
          <a href="/tour/admin/dashboard/enquiries-details" class="admin-nav-btn">
            <i class="fas fa-clipboard-list"></i> Inquiries
          </a>
          <a href="/tour/admin/dashboard/custom-enquiries" class="admin-nav-btn">
            <i class="fas fa-magic"></i> AI Trips
          </a>
          <a href="/tour/admin/chat" class="admin-nav-btn">
            <i class="fas fa-comments"></i> Live Chat
          </a>
          <a href="/tour/admin/dashboard/user-details" class="admin-nav-btn">
            <i class="fas fa-users"></i> Users
          </a>
          <a href="/" class="admin-nav-btn" style="background: rgba(255,255,255,0.08);">
            <i class="fas fa-external-link-alt"></i> View Site
          </a>
        </nav>
      </div>
    </header>

    <main class="dashboard-body">
      <% 
        let totalRevenue = 0;
        let totalTravelers = 0;
        if (bookings && bookings.length > 0) {
          bookings.forEach(b => {
            if (b.status !== 'CANCELLED') {
              totalRevenue += (b.amount || 0);
            }
            totalTravelers += (b.numberOfPeople || 0);
          });
        }
      %>

      <!-- Stat Metrics -->
      <div class="stats-grid-3">
        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">Total Reservations</div>
            <div class="stat-admin-val"><%= bookings ? bookings.length : 0 %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #e0f2fe; color: #0284c7;">
            <i class="fas fa-ticket-alt"></i>
          </div>
        </div>

        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">Total Travelers Booked</div>
            <div class="stat-admin-val"><%= totalTravelers %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #dcfce7; color: #16a34a;">
            <i class="fas fa-users"></i>
          </div>
        </div>

        <div class="stat-card-admin">
          <div>
            <div class="stat-admin-label">Gross Confirmed Revenue</div>
            <div class="stat-admin-val" style="color: #10b981;">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
          </div>
          <div class="stat-icon-wrapper" style="background: #fef3c7; color: #d97706;">
            <i class="fas fa-wallet"></i>
          </div>
        </div>
      </div>

      <!-- Bookings Table Card -->
      <div class="admin-table-card">
        <div class="table-card-header">
          <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--orbit-dark); margin: 0;">Reservation Directory</h2>
            <small class="text-muted">Real-time payment logs, traveler Aadhaar credentials, and refund statuses</small>
          </div>

          <div>
            <select id="tourFilter" class="form-select form-select-sm" style="border-radius: var(--orbit-radius-full); font-weight: 600;">
              <option value="all">Filter by Tour (All)</option>
              <% 
                const uniqueTours = [...new Set((bookings || []).map(b => b.tourName))];
                uniqueTours.forEach(name => { 
              %>
                <option value="<%= name %>"><%= name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div style="overflow-x: auto;">
          <table class="admin-table" id="bookingsTable">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Tour</th>
                <th>Departure Date</th>
                <th>Party & Travelers</th>
                <th>Amount</th>
                <th>Status & Payment ID</th>
                <th>Booked At</th>
              </tr>
            </thead>
            <tbody>
              <% if (bookings && bookings.length > 0) { %>
                <% bookings.forEach(booking => { %>
                  <tr data-tour="<%= booking.tourName %>">
                    <td>
                      <div style="font-weight: 800; color: var(--orbit-dark);"><%= booking.user ? booking.user.fullName : 'Guest' %></div>
                      <small class="text-muted"><%= booking.user ? booking.user.email : 'N/A' %></small>
                    </td>
                    <td>
                      <strong style="color: var(--orbit-primary);"><%= booking.tourName %></strong>
                    </td>
                    <td>
                      <strong><%= new Date(booking.travelDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
                    </td>
                    <td>
                      <div class="mb-1"><strong><%= booking.numberOfPeople %> Travelers</strong></div>
                      <% (booking.travelers || []).forEach((t, i) => { %>
                        <div class="traveler-mini-pill">
                          <%= i + 1 %>. <%= t.name %> (<%= t.aadhaarNumber %>)
                        </div>
                      <% }); %>
                    </td>
                    <td>
                      <strong style="color: #10b981;">₹<%= booking.amount.toLocaleString('en-IN') %></strong>
                    </td>
                    <td>
                      <div class="mb-1">
                        <% if (booking.status === 'CANCELLED') { %>
                          <span class="status-pill-sm cancelled">Cancelled</span>
                        <% } else { %>
                          <span class="status-pill-sm confirmed">Confirmed</span>
                        <% } %>
                      </div>
                      <code style="font-size: 0.75rem;"><%= booking.paymentId || 'N/A' %></code>
                      <% if (booking.refundStatus) { %>
                        <div style="font-size: 0.75rem; color: #991b1b; margin-top: 2px;">
                          Refund: <%= booking.refundStatus %>
                        </div>
                      <% } %>
                    </td>
                    <td>
                      <%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    <i class="fas fa-ticket-alt fa-3x mb-3 opacity-50"></i>
                    <p>No bookings received yet.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include("../partials/scripts") %>

    <script>
      const tourFilter = document.getElementById("tourFilter");
      if (tourFilter) {
        tourFilter.addEventListener("change", function () {
          const selected = this.value;
          const rows = document.querySelectorAll("#bookingsTable tbody tr");

          rows.forEach((row) => {
            if (selected === "all" || row.dataset.tour === selected) {
              row.style.display = "";
            } else {
              row.style.display = "none";
            }
          });
        });
      }
    </script>
  </body>
</html>
