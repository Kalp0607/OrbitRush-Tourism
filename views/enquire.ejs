<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Make an Expedition Inquiry | OrbitRush Tourism</title>
    <%- include("partials/head") %>
    <style>
      .enquiry-page {
        background-color: var(--orbit-light);
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      .enquiry-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 4rem 0 5rem;
        text-align: center;
      }

      .enquiry-hero-title {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
        color: #ffffff;
      }

      .enquiry-hero-subtitle {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 600px;
        margin: 0 auto;
      }

      .enquiry-card-main {
        max-width: 820px;
        margin: -3rem auto 0;
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        box-shadow: var(--orbit-shadow-lg);
        border: 1px solid var(--orbit-border);
        overflow: hidden;
        position: relative;
        z-index: 10;
        padding: 3rem;
      }

      .user-badge-bar {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: var(--orbit-radius-md);
        padding: 1rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 2rem;
        color: #0369a1;
        font-size: 0.95rem;
      }

      .form-section-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .form-section-title i {
        color: var(--orbit-primary);
      }

      .form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .orbit-label {
        display: block;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.5rem;
      }

      .orbit-input, .orbit-select, .orbit-textarea {
        width: 100%;
        padding: 0.9rem 1.2rem;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s;
        font-family: inherit;
        background: #ffffff;
      }

      .orbit-input:focus, .orbit-select:focus, .orbit-textarea:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .orbit-input:disabled {
        background: #f1f5f9;
        color: #64748b;
        cursor: not-allowed;
      }

      .btn-submit-enquiry {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border: none;
        width: 100%;
        padding: 1.15rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1.05rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        box-shadow: 0 8px 25px rgba(2, 132, 199, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
      }

      .btn-submit-enquiry:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 35px rgba(2, 132, 199, 0.45);
        color: white;
      }

      .date-info-tag {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--orbit-primary);
        margin-top: 0.4rem;
      }

      @media (max-width: 768px) {
        .form-grid-2 {
          grid-template-columns: 1fr;
        }
        .enquiry-card-main {
          padding: 2rem 1.5rem;
        }
        .enquiry-hero-title {
          font-size: 2.2rem;
        }
      }
    </style>
  </head>

  <body class="enquiry-page">
    <%- include("partials/nav") %>

    <!-- Hero Header -->
    <section class="enquiry-hero">
      <div class="container">
        <h1 class="enquiry-hero-title">Custom Trip Consultation</h1>
        <p class="enquiry-hero-subtitle">
          Tell us about your dream adventure and our destination specialists will curate a tailored itinerary proposal.
        </p>
      </div>
    </section>

    <!-- Main Container -->
    <div class="container">
      <div class="enquiry-card-main">
        <!-- User Info Strip -->
        <div class="user-badge-bar">
          <i class="fas fa-user-circle fa-lg"></i>
          <div>
            <strong>Inquiring as:</strong> <%= user.fullName %> (<%= user.email %>)
          </div>
        </div>

        <!-- Success & Error Alerts -->
        <% if (locals.success) { %>
          <div class="alert alert-success mb-4" style="border-radius: 12px;">
            <i class="fas fa-check-circle me-2"></i> <%= success %>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger mb-4" style="border-radius: 12px;">
            <i class="fas fa-exclamation-triangle me-2"></i> <%= error %>
          </div>
        <% } %>

        <form action="/tour/enquire" method="POST">
          <!-- Contact Details -->
          <div class="mb-4">
            <h2 class="form-section-title">
              <i class="fas fa-address-book"></i> Contact Details
            </h2>

            <div class="form-grid-2 mb-3">
              <div>
                <label for="fullName" class="orbit-label">Full Name</label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  class="orbit-input"
                  value="<%= user.fullName %>"
                  disabled
                />
              </div>
              <div>
                <label for="email" class="orbit-label">Email Address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="orbit-input"
                  value="<%= user.email %>"
                  disabled
                />
              </div>
            </div>

            <div>
              <label for="phone" class="orbit-label">Phone / WhatsApp Number *</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="orbit-input"
                placeholder="e.g. +91 98765 43210"
                required
              />
            </div>
          </div>

          <!-- Tour Selection & Party -->
          <div class="mb-4">
            <h2 class="form-section-title">
              <i class="fas fa-map-marked-alt"></i> Expedition Preferences
            </h2>

            <div class="form-grid-2 mb-3">
              <div>
                <label for="tourName" class="orbit-label">Select Expedition *</label>
                <select id="tourName" name="tourName" class="orbit-select" required>
                  <option value="">Choose destination...</option>
                  <% tours.forEach(tour => { %>
                    <option
                      value="<%= tour.name %>"
                      data-dates="<%= JSON.stringify(tour.availableDates || []) %>"
                    >
                      <%= tour.name %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label for="numberOfPeople" class="orbit-label">Travelers in Party *</label>
                <input
                  type="number"
                  id="numberOfPeople"
                  name="numberOfPeople"
                  class="orbit-input"
                  min="1"
                  value="1"
                  required
                />
              </div>
            </div>

            <div>
              <label for="preferredDate" class="orbit-label">
                Preferred Departure Date <small class="text-muted">(Optional)</small>
              </label>
              <select id="preferredDate" name="preferredDate" class="orbit-select" disabled>
                <option value="">First select an expedition...</option>
              </select>
              <div id="dateInfo" class="date-info-tag"></div>
            </div>
          </div>

          <!-- Custom Requirements -->
          <div class="mb-4">
            <h2 class="form-section-title">
              <i class="fas fa-comment-dots"></i> Custom Requests & Notes
            </h2>

            <div>
              <label for="message" class="orbit-label">Tell us about your requirements *</label>
              <textarea
                id="message"
                name="message"
                class="orbit-textarea"
                rows="5"
                placeholder="Share any special preferences, dietary requirements, rooming arrangements, or questions..."
                required
              ></textarea>
            </div>
          </div>

          <button type="submit" class="btn-submit-enquiry">
            <i class="fas fa-paper-plane"></i>
            <span>Send Custom Trip Inquiry</span>
          </button>
        </form>
      </div>
    </div>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>

    <script>
      const tourSelect = document.getElementById("tourName");
      const dateSelect = document.getElementById("preferredDate");
      const dateInfo = document.getElementById("dateInfo");

      if (tourSelect && dateSelect) {
        tourSelect.addEventListener("change", function () {
          const selectedOption = this.options[this.selectedIndex];
          const availableDates = JSON.parse(
            selectedOption.getAttribute("data-dates") || "[]"
          );

          dateSelect.innerHTML = "";

          if (availableDates.length === 0) {
            dateSelect.disabled = true;
            dateSelect.innerHTML =
              '<option value="">No scheduled fixed departures — flexible scheduling available</option>';
            if (dateInfo) dateInfo.textContent = "";
            return;
          }

          dateSelect.disabled = false;

          const defaultOption = document.createElement("option");
          defaultOption.value = "";
          defaultOption.textContent = "Select departure date...";
          dateSelect.appendChild(defaultOption);

          const sortedDates = availableDates
            .map((dateStr) => new Date(dateStr))
            .filter((date) => date >= new Date())
            .sort((a, b) => a - b);

          sortedDates.forEach((date) => {
            const option = document.createElement("option");
            const formattedDate = date.toISOString().split("T")[0];
            const displayDate = date.toLocaleDateString("en-IN", {
              day: "numeric",
              month: "long",
              year: "numeric",
            });

            option.value = formattedDate;
            option.textContent = displayDate;
            dateSelect.appendChild(option);
          });

          if (dateInfo) {
            dateInfo.textContent = `${sortedDates.length} upcoming scheduled departure(s) available for this tour`;
          }
        });
      }
    </script>
  </body>
</html>
