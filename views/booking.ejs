<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserve <%= tour.name %> | OrbitRush Tourism</title>
    <%- include("partials/head") %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <style>
      .booking-page {
        background-color: var(--orbit-light);
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      /* Hero Stepper Bar */
      .booking-hero-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 4rem 0 5rem;
        text-align: center;
      }

      .booking-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #38bdf8;
        padding: 0.4rem 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
      }

      .booking-hero-title {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        color: #ffffff;
        margin-bottom: 0.5rem;
      }

      .booking-hero-subtitle {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 600px;
        margin: 0 auto;
      }

      /* Booking Container */
      .booking-card-main {
        max-width: 960px;
        margin: -3rem auto 0;
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        box-shadow: var(--orbit-shadow-lg);
        border: 1px solid var(--orbit-border);
        overflow: hidden;
        position: relative;
        z-index: 10;
      }

      /* Tour Summary Strip */
      .tour-summary-strip {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 2rem 2.5rem;
      }

      .tour-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.2rem;
      }

      .summary-item {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1rem;
        text-align: center;
      }

      .summary-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 2px;
      }

      .summary-val {
        font-size: 1rem;
        font-weight: 800;
        color: var(--orbit-dark);
      }

      /* Form Body */
      .booking-form-body {
        padding: 2.5rem 3rem;
      }

      .form-block {
        margin-bottom: 2.5rem;
      }

      .form-block-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .form-block-title i {
        color: var(--orbit-primary);
      }

      .form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .orbit-label {
        display: block;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.5rem;
      }

      .orbit-input {
        width: 100%;
        padding: 0.9rem 1.2rem;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s;
        font-family: inherit;
        background: #ffffff;
      }

      .orbit-input:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      /* Traveler Card */
      .traveler-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1.5rem;
        margin-bottom: 1.2rem;
      }

      .traveler-card-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--orbit-primary);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Notice Box */
      .orbit-notice-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-left: 4px solid var(--orbit-primary);
        border-radius: 8px;
        padding: 1rem 1.2rem;
        color: #1e40af;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      /* Total Amount Display */
      .total-amount-box {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: white;
        border-radius: var(--orbit-radius-md);
        padding: 1.8rem 2.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
      }

      .total-label {
        font-size: 1.1rem;
        font-weight: 700;
        color: #94a3b8;
      }

      .total-price-val {
        font-size: 2.4rem;
        font-weight: 900;
        color: #ffffff;
      }

      /* Book Submit Button */
      .btn-pay-secure {
        background: linear-gradient(135deg, var(--orbit-accent), var(--orbit-accent-hover));
        color: white;
        border: none;
        width: 100%;
        padding: 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1.15rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        transition: var(--orbit-transition);
        box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4);
      }

      .btn-pay-secure:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 40px rgba(249, 115, 22, 0.55);
        color: white;
      }

      @media (max-width: 768px) {
        .tour-summary-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .form-grid-2 {
          grid-template-columns: 1fr;
        }
        .booking-form-body {
          padding: 1.8rem 1.5rem;
        }
        .booking-hero-title {
          font-size: 2.2rem;
        }
      }
    </style>
  </head>

  <body class="booking-page">
    <%- include("partials/nav") %>

    <!-- Hero Header -->
    <section class="booking-hero-header">
      <div class="container">
        <div class="booking-badge">
          <i class="fas fa-lock"></i> 100% Encrypted & Safe Checkout
        </div>
        <h1 class="booking-hero-title">Confirm Your Reservation</h1>
        <p class="booking-hero-subtitle">
          Complete your journey details to instantly secure your spot on <strong><%= tour.name %></strong>.
        </p>
      </div>
    </section>

    <!-- Main Booking Card -->
    <div class="container">
      <div class="booking-card-main">
        <!-- Tour Summary Strip -->
        <div class="tour-summary-strip">
          <div class="tour-summary-grid">
            <div class="summary-item">
              <div class="summary-label">Selected Tour</div>
              <div class="summary-val"><%= tour.name %></div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Duration</div>
              <div class="summary-val"><%= tour.duration %></div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Location</div>
              <div class="summary-val"><%= tour.location %></div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Price Per Traveler</div>
              <div class="summary-val" style="color: var(--orbit-primary);">₹<%= tour.price.toLocaleString('en-IN') %></div>
            </div>
          </div>
        </div>

        <!-- Booking Form -->
        <div class="booking-form-body">
          <form id="bookingForm">
            <!-- Schedule Section -->
            <div class="form-block">
              <h2 class="form-block-title">
                <i class="fas fa-calendar-alt"></i> Trip Scheduling & Party Size
              </h2>

              <div class="form-grid-2">
                <div>
                  <label for="travelDate" class="orbit-label">Departure Date *</label>
                  <input
                    type="date"
                    id="travelDate"
                    class="orbit-input"
                    required
                  />
                </div>

                <div>
                  <label for="numberOfPeople" class="orbit-label">Number of Travelers *</label>
                  <input
                    type="number"
                    id="numberOfPeople"
                    class="orbit-input"
                    min="1"
                    max="20"
                    value="1"
                    required
                  />
                </div>
              </div>

              <div class="orbit-notice-box mt-3">
                <i class="fas fa-info-circle"></i>
                <span>Your booking and permit allocation are confirmed immediately upon verified payment.</span>
              </div>
            </div>

            <!-- Traveler Details Section -->
            <div class="form-block" id="travelerDetailsSection">
              <h2 class="form-block-title">
                <i class="fas fa-id-card"></i> Traveler Identification Details
              </h2>

              <div class="orbit-notice-box" style="background: #fffbeb; border-color: #fde68a; border-left-color: #f59e0b; color: #92400e;">
                <i class="fas fa-shield-alt"></i>
                <span>Please provide accurate names and 12-digit Aadhaar numbers for mandatory expedition insurance and permits.</span>
              </div>

              <div id="travelerFields"></div>
            </div>

            <!-- Total Amount Strip -->
            <div class="total-amount-box">
              <div>
                <div class="total-label">Total Payable Amount</div>
                <small style="color: #64748b;">(Includes all taxes, permits & guide fees)</small>
              </div>
              <div class="total-price-val">
                ₹<span id="totalAmount"><%= tour.price.toLocaleString('en-IN') %></span>
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-pay-secure">
              <i class="fas fa-lock"></i>
              <span>Pay & Secure Reservation</span>
            </button>
          </form>
        </div>
      </div>
    </div>

    <%- include("partials/scripts") %>

    <script>
      const tourPrice = parseInt("<%= tour.price %>") || 0;
      const tourId = "<%= tour._id %>";
      const tourName = "<%= tour.name %>";

      // Update total amount when number of people changes
      document
        .getElementById("numberOfPeople")
        .addEventListener("input", function () {
          const people = parseInt(this.value) || 1;
          const total = tourPrice * people;
          document.getElementById("totalAmount").textContent =
            total.toLocaleString("en-IN");

          // Generate traveler input fields
          generateTravelerFields(people);
        });

      // Generate traveler detail fields dynamically
      function generateTravelerFields(numberOfPeople) {
        const container = document.getElementById("travelerFields");
        const section = document.getElementById("travelerDetailsSection");

        if (numberOfPeople < 1) {
          section.style.display = "none";
          return;
        }

        section.style.display = "block";
        container.innerHTML = "";

        for (let i = 1; i <= numberOfPeople; i++) {
          const travelerCard = document.createElement("div");
          travelerCard.className = "traveler-card";
          travelerCard.innerHTML = `
            <div class="traveler-card-title">
              <i class="fas fa-user-circle"></i>
              Traveler ${i} Details
            </div>
            <div class="form-grid-2">
              <div>
                <label class="orbit-label">Full Name (as per Govt ID) *</label>
                <input 
                  type="text" 
                  class="orbit-input traveler-name" 
                  placeholder="Enter full name" 
                  required
                  data-traveler="${i}"
                >
              </div>
              <div>
                <label class="orbit-label">Aadhaar Number (12 Digits) *</label>
                <input 
                  type="text" 
                  class="orbit-input traveler-aadhaar" 
                  placeholder="1234-5678-9012" 
                  maxlength="14"
                  required
                  data-traveler="${i}"
                >
              </div>
            </div>
          `;
          container.appendChild(travelerCard);
        }

        addAadhaarFormatting();
      }

      function formatAadhaar(input) {
        let value = input.value.replace(/\D/g, "");
        value = value.substring(0, 12);
        let formatted = "";
        for (let i = 0; i < value.length; i++) {
          if (i === 4 || i === 8) {
            formatted += "-";
          }
          formatted += value[i];
        }
        input.value = formatted;
      }

      function addAadhaarFormatting() {
        const aadhaarInputs = document.querySelectorAll(".traveler-aadhaar");
        aadhaarInputs.forEach((input) => {
          input.addEventListener("input", function () {
            formatAadhaar(this);
          });
        });
      }

      document
        .getElementById("bookingForm")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const travelDate = document.getElementById("travelDate").value;
          const numberOfPeople = parseInt(
            document.getElementById("numberOfPeople").value
          );

          if (!travelDate) {
            Swal.fire({
              icon: "warning",
              title: "Departure Date Required",
              text: "Please select your planned travel date to proceed.",
            });
            return;
          }

          if (numberOfPeople < 1) {
            Swal.fire({
              icon: "warning",
              title: "Invalid Party Size",
              text: "Please specify at least 1 traveler.",
            });
            return;
          }

          // Collect traveler details
          const travelers = [];
          const nameInputs = document.querySelectorAll(".traveler-name");
          const aadhaarInputs = document.querySelectorAll(".traveler-aadhaar");

          for (let i = 0; i < numberOfPeople; i++) {
            const name = nameInputs[i].value.trim();
            const aadhaarFormatted = aadhaarInputs[i].value.trim();
            const aadhaar = aadhaarFormatted.replace(/\D/g, "");

            if (!name) {
              Swal.fire({
                icon: "warning",
                title: `Traveler ${i + 1}: Name Required`,
                text: "Please provide the traveler's full name.",
              });
              nameInputs[i].focus();
              return;
            }

            if (
              !aadhaar ||
              aadhaar.length !== 12 ||
              !/^\d{12}$/.test(aadhaar)
            ) {
              Swal.fire({
                icon: "warning",
                title: `Traveler ${i + 1}: Invalid Aadhaar`,
                text: "Please enter a valid 12-digit Aadhaar number.",
              });
              aadhaarInputs[i].focus();
              return;
            }

            travelers.push({
              name: name,
              aadhaarNumber: aadhaar,
            });
          }

          try {
            // Step 1: Create Razorpay order
            const response = await fetch("/booking/create-order", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ tourId, travelDate, numberOfPeople }),
            });

            const order = await response.json();

            if (order.error) {
              Swal.fire({
                icon: "error",
                title: "Order Creation Failed",
                text: order.error,
              });
              return;
            }

            // Step 2: Open Razorpay payment gateway
            const options = {
              key: order.keyId,
              amount: order.amount,
              currency: order.currency,
              order_id: order.orderId,
              name: "OrbitRush Tourism",
              description: tourName,
              handler: async function (paymentResponse) {
                // Step 3: Verify payment
                try {
                  const verifyResponse = await fetch(
                    "/booking/verify-payment",
                    {
                      method: "POST",
                      headers: { "Content-Type": "application/json" },
                      body: JSON.stringify({
                        razorpay_payment_id:
                          paymentResponse.razorpay_payment_id,
                        razorpay_order_id: paymentResponse.razorpay_order_id,
                        razorpay_signature: paymentResponse.razorpay_signature,
                        tourId: tourId,
                        tourName: tourName,
                        travelDate: travelDate,
                        numberOfPeople: numberOfPeople,
                        travelers: travelers,
                        amount: order.amount,
                      }),
                    }
                  );

                  const result = await verifyResponse.json();

                  if (result.success) {
                    Swal.fire({
                      icon: "success",
                      title: "Expedition Confirmed!",
                      html: `<p>Payment verified successfully.<br><strong>Your journey details have been emailed to you.</strong></p>`,
                      confirmButtonText: "View My Bookings",
                      allowOutsideClick: false,
                    }).then(() => {
                      window.location.href = "/booking/my-bookings";
                    });
                  } else {
                    Swal.fire({
                      icon: "error",
                      title: "Verification Failed",
                      text: result.error,
                    });
                  }
                } catch (error) {
                  console.error(error);
                  Swal.fire({
                    icon: "error",
                    title: "Verification Error",
                    html: `<p>Please contact concierge with payment reference ID:<br><strong>${paymentResponse.razorpay_payment_id}</strong></p>`,
                  });
                }
              },
              prefill: {
                name: "<%= user.fullName %>",
                email: "<%= user.email %>",
              },
              theme: {
                color: "#0284c7",
              },
              modal: {
                ondismiss: function () {
                  Swal.fire({
                    icon: "info",
                    title: "Payment Window Closed",
                    text: "You can resume checkout whenever you're ready.",
                  });
                },
              },
            };

            const rzp = new Razorpay(options);
            rzp.open();
          } catch (error) {
            console.error(error);
            Swal.fire({
              icon: "error",
              title: "Booking System Error",
              text: "Could not initiate payment. Please verify your connection or contact concierge.",
            });
          }
        });

      // Pre-select date if passed in URL query
      const urlParams = new URLSearchParams(window.location.search);
      const preSelectedDate = urlParams.get("date");
      if (preSelectedDate) {
        document.getElementById("travelDate").value = preSelectedDate;
      }

      // Initial traveler generation
      generateTravelerFields(1);
    </script>
  </body>
</html>
