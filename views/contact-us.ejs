<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Contact Concierge | OrbitRush Tourism</title>
    <style>
      .contact-page {
        background-color: var(--orbit-light);
      }

      /* Hero */
      .contact-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 5rem 0 6rem;
        text-align: center;
      }

      .contact-hero-title {
        font-size: 3.6rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: #ffffff;
      }

      .contact-hero-subtitle {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.88);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
      }

      /* Contact Cards */
      .contact-main {
        padding: 4rem 0 6rem;
        margin-top: -3rem;
        position: relative;
        z-index: 5;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-bottom: 4rem;
      }

      .contact-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 3rem 2rem;
        text-align: center;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-md);
        transition: var(--orbit-transition);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .contact-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
        border-color: var(--orbit-primary);
      }

      .contact-icon-box {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        background: rgba(2, 132, 199, 0.1);
        color: var(--orbit-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1.5rem;
        transition: var(--orbit-transition);
      }

      .contact-card:hover .contact-icon-box {
        background: var(--orbit-primary);
        color: #ffffff;
        transform: scale(1.1);
      }

      .contact-card-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.5rem;
      }

      .contact-card-info {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--orbit-primary);
        margin-bottom: 0.75rem;
        word-break: break-all;
      }

      .contact-card-desc {
        font-size: 0.9rem;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 1.8rem;
      }

      .btn-contact-action {
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        color: var(--orbit-dark);
        padding: 0.75rem 1.5rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: var(--orbit-transition);
      }

      .btn-contact-action:hover {
        background: var(--orbit-primary);
        border-color: var(--orbit-primary);
        color: #ffffff;
        transform: translateY(-2px);
      }

      /* Hours & Support Banner */
      .hours-card {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: white;
        border-radius: var(--orbit-radius-lg);
        padding: 3.5rem 3rem;
        box-shadow: var(--orbit-shadow-lg);
      }

      .hours-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 2rem;
      }

      .hours-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--orbit-radius-md);
        padding: 1.5rem;
        text-align: center;
      }

      .hours-item-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.4rem;
      }

      .hours-item-val {
        color: #38bdf8;
        font-weight: 700;
        font-size: 0.95rem;
      }

      @media (max-width: 991px) {
        .contact-grid {
          grid-template-columns: 1fr;
        }
        .hours-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body class="contact-page">
    <%- include("partials/nav") %>

    <!-- Hero -->
    <section class="contact-hero">
      <div class="container">
        <span class="about-badge" style="background: rgba(255,255,255,0.15); color: #38bdf8; border: 1px solid rgba(255,255,255,0.3); padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; text-transform: uppercase;">
          <i class="fas fa-headset me-1"></i> Dedicated Concierge
        </span>
        <h1 class="contact-hero-title">We are Here for Your Journey</h1>
        <p class="contact-hero-subtitle">
          Have an inquiry about an upcoming departure, private charter, or bespoke route? Our travel specialists are available 24/7.
        </p>
      </div>
    </section>

    <!-- Main Contact Channels -->
    <main class="contact-main">
      <div class="container">
        <div class="contact-grid">
          <!-- Phone -->
          <div class="contact-card">
            <div>
              <div class="contact-icon-box">
                <i class="fas fa-phone-alt"></i>
              </div>
              <h2 class="contact-card-title">Phone & Direct Call</h2>
              <div class="contact-card-info">+91 98765 43210</div>
              <p class="contact-card-desc">
                Speak directly with an expedition specialist for instant availability and route guidance.
              </p>
            </div>
            <a href="tel:+919876543210" class="btn-contact-action">
              <i class="fas fa-phone"></i> Call Concierge
            </a>
          </div>

          <!-- Email -->
          <div class="contact-card">
            <div>
              <div class="contact-icon-box" style="background: rgba(249, 115, 22, 0.1); color: var(--orbit-accent);">
                <i class="fas fa-envelope-open-text"></i>
              </div>
              <h2 class="contact-card-title">Email Inquiries</h2>
              <div class="contact-card-info" style="color: var(--orbit-accent);">orbitrushtourism@gmail.com</div>
              <p class="contact-card-desc">
                Send us your detailed travel wishlist or itinerary questions. We respond within 2 hours.
              </p>
            </div>
            <a href="mailto:orbitrushtourism@gmail.com" class="btn-contact-action">
              <i class="fas fa-paper-plane"></i> Email Team
            </a>
          </div>

          <!-- Custom Trip Plan -->
          <div class="contact-card">
            <div>
              <div class="contact-icon-box" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                <i class="fas fa-magic"></i>
              </div>
              <h2 class="contact-card-title">Custom Trip Request</h2>
              <div class="contact-card-info" style="color: #8b5cf6;">Bespoke Planning</div>
              <p class="contact-card-desc">
                Fill out our guided inquiry form or chat with our AI planner for tailored destination quotes.
              </p>
            </div>
            <a href="/tour/enquire" class="btn-contact-action">
              <i class="fas fa-compass"></i> Create Custom Trip
            </a>
          </div>
        </div>

        <!-- Business Hours & Service Guarantees -->
        <div class="hours-card">
          <div class="text-center">
            <h2 style="font-size: 2.2rem; font-weight: 800; color: #ffffff; margin-bottom: 0.5rem;">
              Support Hours & Response Windows
            </h2>
            <p style="color: #94a3b8; max-width: 550px; margin: 0 auto;">
              Our global team operates across timezones to ensure seamless on-trip security.
            </p>
          </div>

          <div class="hours-grid">
            <div class="hours-item">
              <div class="hours-item-title">Active Voyagers Support</div>
              <div class="hours-item-val"><i class="fas fa-bolt me-1"></i> 24/7 VIP Emergency Line</div>
            </div>
            <div class="hours-item">
              <div class="hours-item-title">Booking & Consultations</div>
              <div class="hours-item-val"><i class="far fa-clock me-1"></i> Mon - Sat: 9:00 AM - 8:00 PM IST</div>
            </div>
            <div class="hours-item">
              <div class="hours-item-title">Live Chat Widget</div>
              <div class="hours-item-val"><i class="fas fa-circle text-success me-1"></i> Online Real-Time</div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>
  </body>
</html>
