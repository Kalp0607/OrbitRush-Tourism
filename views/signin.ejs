<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Member Sign In | OrbitRush Tourism</title>
    <style>
      .auth-page {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0369a1 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .auth-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
      }

      .auth-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: var(--orbit-radius-lg);
        padding: 3rem 2.5rem;
        max-width: 440px;
        width: 100%;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.8);
      }

      .auth-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .auth-logo {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        margin-bottom: 1rem;
        object-fit: cover;
      }

      .auth-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.3rem;
      }

      .auth-subtitle {
        color: #64748b;
        font-size: 0.92rem;
        margin: 0;
      }

      .orbit-auth-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.4rem;
      }

      .orbit-auth-input {
        width: 100%;
        padding: 0.85rem 1.2rem;
        border: 1.5px solid #cbd5e1;
        border-radius: var(--orbit-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: var(--orbit-transition);
        font-family: inherit;
      }

      .orbit-auth-input:focus {
        border-color: var(--orbit-primary);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .btn-auth-submit {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border: none;
        width: 100%;
        padding: 0.95rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        box-shadow: 0 8px 25px rgba(2, 132, 199, 0.35);
        margin-top: 1rem;
      }

      .btn-auth-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(2, 132, 199, 0.45);
        color: white;
      }
    </style>
  </head>

  <body class="auth-page">
    <%- include("partials/nav") %>

    <main class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <img src="/images/1760177356614.png" alt="OrbitRush" class="auth-logo" />
          <h1 class="auth-title">Welcome Back</h1>
          <p class="auth-subtitle">Sign in to manage your expeditions</p>
        </div>

        <form action="/user/signin" method="post">
          <div class="mb-3">
            <label for="exampleInputEmail1" class="orbit-auth-label">Email Address</label>
            <input
              type="email"
              class="orbit-auth-input"
              id="exampleInputEmail1"
              name="email"
              placeholder="explorer@orbitrush.com"
              required
            />
            <small class="text-muted" style="font-size: 0.75rem;">Your registered account email</small>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="exampleInputPassword1" class="orbit-auth-label mb-0">Password</label>
              <a href="/user/forgot-password" style="font-size: 0.8rem; font-weight: 700; color: var(--orbit-primary); text-decoration: none;">
                Forgot?
              </a>
            </div>
            <input
              type="password"
              class="orbit-auth-input"
              id="exampleInputPassword1"
              placeholder="Enter your password"
              name="password"
              required
            />
          </div>

          <button type="submit" class="btn-auth-submit">
            <span>Sign In</span>
            <i class="fas fa-arrow-right ms-1"></i>
          </button>

          <p class="text-center text-muted mt-4 mb-0" style="font-size: 0.9rem;">
            Don't have an account?
            <a href="/user/signup" style="font-weight: 700; color: var(--orbit-primary); text-decoration: none;">
              Create one
            </a>
          </p>
        </form>
      </div>
    </main>

    <%- include("partials/scripts") %>
  </body>
</html>
