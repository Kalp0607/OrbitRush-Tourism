<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Our Story & Leadership | OrbitRush Tourism</title>
    <style>
      .about-page {
        background-color: var(--orbit-light);
      }

      /* Hero Section */
      .about-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 5rem 0 6rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .about-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #38bdf8;
        padding: 0.45rem 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1.2rem;
      }

      .about-hero-title {
        font-size: 3.8rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: #ffffff;
      }

      .about-hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.88);
        max-width: 720px;
        margin: 0 auto;
        line-height: 1.7;
      }

      /* DNA / Mission Split Section */
      .dna-section {
        padding: 6rem 0;
      }

      .dna-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 3.5rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-md);
      }

      .dna-title {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
      }

      .dna-text {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #475569;
        margin-bottom: 1.5rem;
      }

      .dna-metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-top: 3rem;
      }

      .dna-metric-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1.8rem 1.2rem;
        text-align: center;
        transition: var(--orbit-transition);
      }

      .dna-metric-box:hover {
        transform: translateY(-5px);
        box-shadow: var(--orbit-shadow-sm);
        border-color: var(--orbit-primary);
      }

      .dna-metric-num {
        font-size: 2.6rem;
        font-weight: 900;
        color: var(--orbit-primary);
        line-height: 1;
        margin-bottom: 0.4rem;
      }

      .dna-metric-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
      }

      /* Leadership Team Grid */
      .team-section {
        padding: 4rem 0 6rem;
        background: #f8fafc;
      }

      .team-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
        margin-top: 3rem;
      }

      .executive-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 2.5rem;
        border: 1px solid var(--orbit-border);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        display: flex;
        gap: 2rem;
        align-items: flex-start;
        transition: var(--orbit-transition);
      }

      .executive-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.1);
      }

      .executive-avatar {
        width: 100px;
        height: 100px;
        border-radius: 24px;
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 900;
        flex-shrink: 0;
        box-shadow: 0 10px 25px rgba(2, 132, 199, 0.35);
      }

      .executive-name {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.2rem;
      }

      .executive-role {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--orbit-primary);
        margin-bottom: 1rem;
      }

      .executive-bio {
        color: #64748b;
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 1rem;
      }

      .specialty-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .specialty-tag {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.3rem 0.8rem;
        border-radius: var(--orbit-radius-full);
        background: #f1f5f9;
        color: #475569;
      }

      /* Call to Excellence */
      .cte-banner {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: white;
        border-radius: var(--orbit-radius-lg);
        padding: 4rem 3rem;
        text-align: center;
        margin-bottom: 4rem;
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.2);
      }

      .cte-title {
        font-size: 2.8rem;
        font-weight: 900;
        color: #ffffff;
        margin-bottom: 1rem;
      }

      @media (max-width: 991px) {
        .about-hero-title {
          font-size: 2.8rem;
        }
        .team-grid {
          grid-template-columns: 1fr;
        }
        .dna-metrics-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 767px) {
        .executive-card {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
        .specialty-tags {
          justify-content: center;
        }
      }
    </style>
  </head>

  <body class="about-page">
    <%- include("partials/nav") %>

    <!-- Hero Header -->
    <section class="about-hero">
      <div class="container">
        <div class="about-badge">
          <i class="fas fa-compass"></i> Our Purpose & Vision
        </div>
        <h1 class="about-hero-title">Redefining Luxury Exploration</h1>
        <p class="about-hero-subtitle">
          We craft transformative journeys for those who seek the extraordinary. Guided by unyielding standards of excellence, culture, and environmental stewardship.
        </p>
      </div>
    </section>

    <!-- DNA & Core Principles -->
    <section class="dna-section">
      <div class="container">
        <div class="dna-card">
          <div class="row align-items-center g-5">
            <div class="col-lg-6">
              <h2 class="dna-title">Our DNA is Excellence in Every Milestone</h2>
              <p class="dna-text">
                Founded on the belief that travel should be both deeply luxurious and culturally transformative, OrbitRush curates bespoke journeys that bypass generic tourism in favor of genuine intimacy with the world.
              </p>
              <p class="dna-text">
                From high-altitude Himalayan ascents to secluded coastal sanctuaries, our platform merges elite concierge support, verified guides, and seamless digital booking.
              </p>
            </div>
            <div class="col-lg-6">
              <img
                src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
                alt="Excellence in Action"
                style="width: 100%; height: 360px; object-fit: cover; border-radius: var(--orbit-radius-lg); box-shadow: var(--orbit-shadow-md);"
              />
            </div>
          </div>

          <!-- Metrics Strip -->
          <div class="dna-metrics-grid">
            <div class="dna-metric-box">
              <div class="dna-metric-num">5.0★</div>
              <div class="dna-metric-label">Average Satisfaction</div>
            </div>
            <div class="dna-metric-box">
              <div class="dna-metric-num">150+</div>
              <div class="dna-metric-label">Global Partners</div>
            </div>
            <div class="dna-metric-box">
              <div class="dna-metric-num">98%</div>
              <div class="dna-metric-label">Repeat Voyagers</div>
            </div>
            <div class="dna-metric-box">
              <div class="dna-metric-num">24h</div>
              <div class="dna-metric-label">Concierge Response</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Leadership Section -->
    <section class="team-section">
      <div class="container">
        <div class="text-center max-w-700 mx-auto mb-4">
          <span class="about-badge" style="background: rgba(2, 132, 199, 0.1); color: var(--orbit-primary);">
            <i class="fas fa-users"></i> Executive Leadership
          </span>
          <h2 style="font-size: 2.6rem; font-weight: 800; color: var(--orbit-dark); letter-spacing: -0.02em;">
            Architects of the OrbitRush Vision
          </h2>
        </div>

        <div class="team-grid">
          <!-- Patel Rudra -->
          <article class="executive-card">
            <div class="executive-avatar">PR</div>
            <div>
              <h3 class="executive-name">Patel Rudra</h3>
              <div class="executive-role">Co-Founder & Chief Technology Officer</div>
              <p class="executive-bio">
                Technology visionary and digital platform architect who engineers our high-speed booking, real-time tracking, and AI-assisted expedition planning interfaces.
              </p>
              <div class="specialty-tags">
                <span class="specialty-tag">Digital Innovation</span>
                <span class="specialty-tag">Platform Architecture</span>
                <span class="specialty-tag">User Experience</span>
              </div>
            </div>
          </article>

          <!-- Jha Prasoon -->
          <article class="executive-card">
            <div class="executive-avatar" style="background: linear-gradient(135deg, var(--orbit-accent), var(--orbit-accent-hover));">JP</div>
            <div>
              <h3 class="executive-name">Jha Prasoon</h3>
              <div class="executive-role">Co-Founder & Chief Operating Officer</div>
              <p class="executive-bio">
                Operations strategist with deep expertise in international hospitality partnerships and guest safety. Prasoon ensures every on-ground itinerary unfolds with flawless precision.
              </p>
              <div class="specialty-tags">
                <span class="specialty-tag">Global Operations</span>
                <span class="specialty-tag">VIP Concierge</span>
                <span class="specialty-tag">Service Excellence</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Call to Excellence -->
    <div class="container mt-5">
      <div class="cte-banner">
        <h2 class="cte-title">Experience the OrbitRush Difference</h2>
        <p style="font-size: 1.15rem; color: #cbd5e1; max-width: 620px; margin: 0 auto 2rem;">
          Join thousands of discerning travelers who have unlocked extraordinary horizons with our team.
        </p>
        <a href="/tour" class="btn-orbit-hero btn-orbit-primary">
          <span>Explore All Destinations</span>
          <i class="fas fa-arrow-right ms-1"></i>
        </a>
      </div>
    </div>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>
  </body>
</html>
