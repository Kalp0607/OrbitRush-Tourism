<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>My Inquiries | OrbitRush Tourism</title>
    <style>
      .enquiries-page {
        background-color: var(--orbit-light);
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      /* Hero Header */
      .enquiries-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 4rem 0 5rem;
        text-align: center;
      }

      .enquiries-hero-title {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
        color: #ffffff;
      }

      .enquiries-hero-subtitle {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 600px;
        margin: 0 auto;
      }

      .enquiries-content-wrap {
        max-width: 1100px;
        margin: -3rem auto 0;
        position: relative;
        z-index: 10;
      }

      /* Controls & Stats Bar */
      .enquiries-controls-bar {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 1.5rem 2rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-md);
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1.2rem;
      }

      .enquiry-stat-pills {
        display: flex;
        gap: 1rem;
        align-items: center;
      }

      .stat-pill {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-full);
        padding: 0.45rem 1.1rem;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--orbit-dark);
      }

      .filter-tabs {
        display: flex;
        gap: 0.5rem;
        background: #f1f5f9;
        padding: 0.35rem;
        border-radius: var(--orbit-radius-full);
      }

      .filter-tab-btn {
        background: transparent;
        border: none;
        padding: 0.45rem 1.1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.88rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        transition: var(--orbit-transition);
      }

      .filter-tab-btn.active {
        background: #ffffff;
        color: var(--orbit-dark);
        box-shadow: var(--orbit-shadow-sm);
      }

      /* Enquiry Cards */
      .enquiry-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        padding: 2rem;
        margin-bottom: 1.5rem;
        transition: var(--orbit-transition);
      }

      .enquiry-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--orbit-shadow-md);
        border-color: var(--orbit-primary);
      }

      .enquiry-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.2rem;
        flex-wrap: wrap;
        gap: 0.8rem;
      }

      .enquiry-tour-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin: 0;
      }

      .enquiry-date-pill {
        background: #f0f9ff;
        color: #0369a1;
        border: 1px solid #bae6fd;
        padding: 0.35rem 0.85rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.82rem;
        font-weight: 700;
      }

      .enquiry-details-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.2rem;
      }

      .enquiry-detail-cell {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-sm);
        padding: 0.85rem 1rem;
      }

      .detail-label-sub {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
      }

      .detail-val-main {
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--orbit-dark);
      }

      .enquiry-message-box {
        background: #f8fafc;
        border-left: 3px solid var(--orbit-primary);
        padding: 1rem 1.2rem;
        border-radius: 8px;
        font-size: 0.92rem;
        color: #334155;
        line-height: 1.6;
      }

      @media (max-width: 991px) {
        .enquiry-details-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 600px) {
        .enquiry-details-grid {
          grid-template-columns: 1fr;
        }
        .enquiries-controls-bar {
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>

  <body class="enquiries-page">
    <%- include("partials/nav") %>

    <!-- Hero Header -->
    <section class="enquiries-hero">
      <div class="container">
        <h1 class="enquiries-hero-title">My Custom Inquiries</h1>
        <p class="enquiries-hero-subtitle">
          Track proposal updates, custom quotes, and communication for your personalized itineraries.
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="container">
      <div class="enquiries-content-wrap">
        <!-- Controls & Filters -->
        <div class="enquiries-controls-bar">
          <div class="enquiry-stat-pills">
            <div class="stat-pill">
              <i class="fas fa-clipboard-list text-primary me-1"></i>
              Total Inquiries: <strong><%= enquiries.length %></strong>
            </div>
            <div class="stat-pill">
              <i class="fas fa-calendar-week text-success me-1"></i>
              Recent: <strong><%= enquiries.filter(e => new Date() - new Date(e.createdAt) <= 7*24*60*60*1000).length %></strong>
            </div>
          </div>

          <div class="d-flex align-items-center gap-3">
            <div class="filter-tabs">
              <button class="filter-tab-btn active" onclick="filterEnquiries('all')">All</button>
              <button class="filter-tab-btn" onclick="filterEnquiries('recent')">Past 7 Days</button>
            </div>
            <a href="/tour/enquire" class="btn-orbit-hero btn-orbit-primary" style="padding: 0.6rem 1.3rem; font-size: 0.88rem;">
              <i class="fas fa-plus"></i> New Request
            </a>
          </div>
        </div>

        <!-- Inquiries Stream -->
        <div id="enquiriesGrid">
          <% if (enquiries && enquiries.length > 0) { %>
            <% enquiries.forEach(enquiry => { %>
              <article class="enquiry-card" data-date="<%= enquiry.createdAt %>">
                <div class="enquiry-header">
                  <h3 class="enquiry-tour-title"><%= enquiry.tourName %></h3>
                  <span class="enquiry-date-pill">
                    <i class="far fa-calendar-alt me-1"></i>
                    <%= new Date(enquiry.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </span>
                </div>

                <div class="enquiry-details-grid">
                  <div class="enquiry-detail-cell">
                    <div class="detail-label-sub">Party Size</div>
                    <div class="detail-val-main"><%= enquiry.numberOfPeople %> Traveler(s)</div>
                  </div>

                  <div class="enquiry-detail-cell">
                    <div class="detail-label-sub">Target Date</div>
                    <div class="detail-val-main">
                      <% if (enquiry.preferredDate) { %>
                        <%= new Date(enquiry.preferredDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      <% } else { %>
                        Flexible
                      <% } %>
                    </div>
                  </div>

                  <div class="enquiry-detail-cell">
                    <div class="detail-label-sub">Phone</div>
                    <div class="detail-val-main"><%= enquiry.phone %></div>
                  </div>

                  <div class="enquiry-detail-cell">
                    <div class="detail-label-sub">Email</div>
                    <div class="detail-val-main" style="word-break: break-all;"><%= enquiry.email %></div>
                  </div>
                </div>

                <% if (enquiry.message) { %>
                  <div class="enquiry-message-box">
                    <strong style="color: var(--orbit-primary); display: block; font-size: 0.82rem; margin-bottom: 2px;">Your Request Notes:</strong>
                    <%= enquiry.message %>
                  </div>
                <% } %>
              </article>
            <% }) %>
          <% } else { %>
            <div class="text-center py-5 bg-white rounded-4 border p-4">
              <i class="fas fa-paper-plane fa-3x text-muted mb-3 opacity-50"></i>
              <h3 style="font-weight: 800; color: var(--orbit-dark);">No Inquiries Yet</h3>
              <p class="text-muted mb-4">Ready for a tailor-made expedition? Tell us where you want to go.</p>
              <a href="/tour/enquire" class="btn-orbit-hero btn-orbit-primary">
                <i class="fas fa-magic me-1"></i> Create Custom Trip Request
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>

    <script>
      function filterEnquiries(filter) {
        const cards = document.querySelectorAll(".enquiry-card");
        const tabs = document.querySelectorAll(".filter-tab-btn");

        tabs.forEach((tab) => tab.classList.remove("active"));
        event.target.classList.add("active");

        if (filter === "all") {
          cards.forEach((card) => (card.style.display = "block"));
        } else if (filter === "recent") {
          const oneWeekAgo = new Date();
          oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

          cards.forEach((card) => {
            const cardDate = new Date(card.getAttribute("data-date"));
            card.style.display = cardDate > oneWeekAgo ? "block" : "none";
          });
        }
      }
    </script>
  </body>
</html>
