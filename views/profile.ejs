<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>My Profile | OrbitRush Tourism</title>
    <style>
      .profile-page {
        background-color: var(--orbit-light);
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      .profile-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 4rem 0 5rem;
      }

      .profile-header-card {
        max-width: 1100px;
        margin: -3rem auto 0;
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 2.5rem 3rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-lg);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 2rem;
        position: relative;
        z-index: 10;
      }

      .profile-avatar-wrap {
        position: relative;
      }

      .profile-avatar-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.15);
      }

      .profile-verified-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        background: #10b981;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #ffffff;
        font-size: 0.8rem;
      }

      .profile-main-name {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.2rem;
      }

      .profile-main-email {
        color: #64748b;
        font-size: 1rem;
        margin: 0;
      }

      /* Content Grid */
      .profile-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        max-width: 1100px;
        margin: 2.5rem auto 0;
      }

      .profile-section-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 2.2rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
      }

      .profile-card-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .profile-info-row {
        margin-bottom: 1.2rem;
      }

      .profile-info-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 2px;
      }

      .profile-info-val {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--orbit-dark);
      }

      /* Quick Action Link */
      .profile-action-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        text-decoration: none;
        color: var(--orbit-dark);
        margin-bottom: 0.8rem;
        transition: var(--orbit-transition);
      }

      .profile-action-link:hover {
        background: #f0f9ff;
        border-color: var(--orbit-primary);
        transform: translateX(4px);
        color: var(--orbit-dark);
      }

      .profile-action-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
      }

      /* Recent Enquiries Box */
      .recent-enquiries-box {
        max-width: 1100px;
        margin: 2.5rem auto 0;
      }

      @media (max-width: 991px) {
        .profile-grid-2 {
          grid-template-columns: 1fr;
        }
        .profile-header-card {
          flex-direction: column;
          text-align: center;
          padding: 2rem;
        }
      }
    </style>
  </head>

  <body class="profile-page">
    <%- include("partials/nav") %>

    <!-- Hero Header -->
    <section class="profile-hero">
      <div class="container text-center">
        <h1 style="font-size: 2.5rem; font-weight: 900; color: #ffffff; margin-bottom: 0.4rem;">
          Explorer Profile
        </h1>
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 1.05rem;">
          Manage your account credentials and personal preferences.
        </p>
      </div>
    </section>

    <!-- Profile Header Card -->
    <div class="container">
      <div class="profile-header-card">
        <div class="d-flex align-items-center gap-4 flex-wrap flex-md-nowrap justify-content-center justify-content-md-start">
          <div class="profile-avatar-wrap">
            <img
              src="<%= user.profileImageURL || '/images/default-avatar.png' %>"
              alt="<%= user.fullName %>"
              class="profile-avatar-img"
              onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.fullName) %>&background=0284c7&color=fff'"
            />
            <div class="profile-verified-badge" title="Verified Member">
              <i class="fas fa-check"></i>
            </div>
          </div>

          <div>
            <h2 class="profile-main-name"><%= user.fullName %></h2>
            <p class="profile-main-email">
              <i class="fas fa-envelope text-primary me-1"></i> <%= user.email %>
            </p>
          </div>
        </div>

        <a href="/tour/enquire" class="btn-orbit-hero btn-orbit-primary" style="padding: 0.8rem 1.6rem; font-size: 0.92rem;">
          <i class="fas fa-paper-plane"></i>
          <span>New Inquiry</span>
        </a>
      </div>

      <!-- Account & Quick Actions Grid -->
      <div class="profile-grid-2">
        <!-- Account Info -->
        <div class="profile-section-card">
          <h3 class="profile-card-title">
            <i class="fas fa-id-badge text-primary"></i> Account Credentials
          </h3>

          <div class="profile-info-row">
            <div class="profile-info-label">Full Name</div>
            <div class="profile-info-val"><%= user.fullName %></div>
          </div>

          <div class="profile-info-row">
            <div class="profile-info-label">Email Address</div>
            <div class="profile-info-val"><%= user.email %></div>
          </div>

          <div class="profile-info-row">
            <div class="profile-info-label">Account Membership</div>
            <div class="profile-info-val">
              <span class="badge bg-primary px-3 py-2" style="border-radius: 9999px; font-weight: 700;">
                <%= user.role || 'Explorer Member' %>
              </span>
            </div>
          </div>
        </div>

        <!-- Quick Shortcuts -->
        <div class="profile-section-card">
          <h3 class="profile-card-title">
            <i class="fas fa-bolt text-warning"></i> Quick Shortcuts
          </h3>

          <a href="/tour" class="profile-action-link">
            <div class="profile-action-icon" style="background: rgba(2, 132, 199, 0.1); color: var(--orbit-primary);">
              <i class="fas fa-compass"></i>
            </div>
            <div>
              <div style="font-weight: 700;">Explore Expeditions</div>
              <small class="text-muted">Browse hand-crafted luxury packages</small>
            </div>
          </a>

          <a href="/booking/my-bookings" class="profile-action-link">
            <div class="profile-action-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
              <i class="fas fa-ticket-alt"></i>
            </div>
            <div>
              <div style="font-weight: 700;">My Reservations</div>
              <small class="text-muted">View confirmed departure dates & permits</small>
            </div>
          </a>

          <a href="/contact-us" class="profile-action-link">
            <div class="profile-action-icon" style="background: rgba(249, 115, 22, 0.1); color: var(--orbit-accent);">
              <i class="fas fa-headset"></i>
            </div>
            <div>
              <div style="font-weight: 700;">24/7 Concierge Support</div>
              <small class="text-muted">Contact our expedition specialists</small>
            </div>
          </a>
        </div>
      </div>

      <!-- Recent Inquiries Section -->
      <div class="recent-enquiries-box">
        <div class="profile-section-card">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="profile-card-title mb-0">
              <i class="fas fa-history text-primary"></i> Recent Inquiries
            </h3>
            <a href="/tour/enquire" class="btn-orbit-hero btn-orbit-glass" style="color: var(--orbit-dark); border-color: #cbd5e1; padding: 0.45rem 1rem; font-size: 0.82rem;">
              <i class="fas fa-plus"></i> New Request
            </a>
          </div>

          <% if (enquiries && enquiries.length > 0) { %>
            <% enquiries.forEach(enquiry => { %>
              <div class="p-3 mb-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid var(--orbit-primary);">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h4 style="font-size: 1.1rem; font-weight: 800; color: var(--orbit-dark); margin: 0;"><%= enquiry.tourName %></h4>
                  <span class="text-muted" style="font-size: 0.82rem; font-weight: 600;">
                    <i class="far fa-calendar me-1"></i> <%= new Date(enquiry.createdAt).toLocaleDateString() %>
                  </span>
                </div>
                <div class="d-flex gap-4 flex-wrap text-muted" style="font-size: 0.88rem;">
                  <span><strong>Party:</strong> <%= enquiry.numberOfPeople %> Travelers</span>
                  <span><strong>Date:</strong> <%= enquiry.preferredDate ? new Date(enquiry.preferredDate).toLocaleDateString() : 'Flexible' %></span>
                  <span><strong>Phone:</strong> <%= enquiry.phone %></span>
                </div>
                <% if (enquiry.message) { %>
                  <p class="mt-2 mb-0 text-muted" style="font-size: 0.88rem; line-height: 1.5; border-top: 1px solid #e2e8f0; padding-top: 6px;">
                    "<%= enquiry.message %>"
                  </p>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-4 text-muted">
              <i class="fas fa-inbox fa-2x mb-2 opacity-50"></i>
              <p>No recent inquiries. Plan a bespoke trip whenever you are ready.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>
  </body>
</html>
