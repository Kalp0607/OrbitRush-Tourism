<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Error Encountered | OrbitRush</title>
    <style>
      body {
        background-color: var(--orbit-light);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      .error-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 3.5rem 2.5rem;
        max-width: 520px;
        width: 100%;
        text-align: center;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-lg);
      }
      .error-icon-box {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #fef2f2;
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin: 0 auto 1.5rem;
      }
      .error-title {
        font-size: 2rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.75rem;
      }
      .error-message {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
      }
    </style>
  </head>
  <body>
    <div class="error-card">
      <div class="error-icon-box">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <h1 class="error-title">Notice</h1>
      <p class="error-message"><%= message %></p>
      <a href="/" class="btn-orbit-hero btn-orbit-primary" style="padding: 0.85rem 2rem; font-size: 0.95rem; display: inline-flex;">
        <i class="fas fa-home me-1"></i> Return to Homepage
      </a>
    </div>
  </body>
</html>
