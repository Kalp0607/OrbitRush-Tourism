<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Error Encountered | OrbitRush</title>
    <style>
      body {
        background-color: var(--orbit-light);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      .error-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 3.5rem 2.5rem;
        max-width: 520px;
        width: 100%;
        text-align: center;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-lg);
      }
      .error-icon-box {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #fef2f2;
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin: 0 auto 1.5rem;
      }
      .error-title {
        font-size: 2rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 0.75rem;
      }
      .error-message {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
      }
    </style>
  </head>
  <body>
    <div class="error-card">
      <div class="error-icon-box">
        <i class="fas fa-<%= locals.statusCode === 404 ? 'compass' : 'exclamation-triangle' %>"></i>
      </div>
      <h1 class="error-title"><%= locals.title || (locals.statusCode === 404 ? 'Page Not Found' : 'Notice') %></h1>
      <p class="error-message"><%= locals.message || 'The requested page or resource is currently unavailable. Please return to the homepage or check our expedition catalog.' %></p>
      <div class="d-flex justify-content-center gap-2">
        <a href="/" class="btn-orbit-hero btn-orbit-primary" style="padding: 0.85rem 1.75rem; font-size: 0.95rem; display: inline-flex; align-items: center;">
          <i class="fas fa-home me-2"></i> Homepage
        </a>
        <a href="/tour" class="btn-orbit-hero btn-orbit-secondary" style="padding: 0.85rem 1.75rem; font-size: 0.95rem; display: inline-flex; align-items: center; border: 1.5px solid var(--orbit-primary); color: var(--orbit-primary); background: transparent;">
          <i class="fas fa-compass me-2"></i> Explore Tours
        </a>
      </div>
    </div>
  </body>
</html>
