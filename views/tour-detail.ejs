<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title><%= tour.name %> | OrbitRush Luxury Expeditions</title>
    <style>
      .detail-page {
        background-color: var(--orbit-light);
      }

      /* Hero Section with Parallax Background */
      .detail-hero {
        position: relative;
        min-height: 65vh;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.4) 0%, rgba(15, 23, 42, 0.85) 100%),
          url("<%= tour.coverImage %>");
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        color: white;
        margin-top: -100px;
        padding: 140px 0 4rem 0;
      }

      .detail-hero-content {
        position: relative;
        z-index: 2;
        max-width: 900px;
      }

      .detail-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        padding: 0.4rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
      }

      .detail-title {
        font-size: 3.6rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: #ffffff;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }

      .detail-hero-meta {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        align-items: center;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.95);
      }

      .detail-meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
      }

      .detail-meta-item i {
        color: var(--orbit-primary-light);
      }

      /* Main Content Layout */
      .detail-main {
        padding: 3.5rem 0 6rem;
      }

      /* Detail Cards */
      .detail-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 2.2rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        margin-bottom: 2rem;
        transition: var(--orbit-transition);
      }

      .detail-card-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .detail-card-title i {
        color: var(--orbit-primary);
        font-size: 1.3rem;
      }

      /* Key Metric Quick Grid */
      .metrics-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .metric-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1.25rem 1rem;
        text-align: center;
      }

      .metric-box-icon {
        font-size: 1.3rem;
        color: var(--orbit-primary);
        margin-bottom: 0.4rem;
      }

      .metric-box-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
      }

      .metric-box-val {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--orbit-dark);
      }

      /* Available Dates Grid */
      .dates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .date-badge-pill {
        background: #f0f9ff;
        border: 1.5px solid #bae6fd;
        color: #0369a1;
        padding: 0.8rem 1rem;
        border-radius: var(--orbit-radius-md);
        font-weight: 700;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: var(--orbit-transition);
        text-align: center;
      }

      .date-badge-pill:hover {
        background: var(--orbit-primary);
        color: #ffffff;
        border-color: var(--orbit-primary);
      }

      .btn-show-dates {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        color: var(--orbit-dark);
        padding: 0.6rem 1.4rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      .btn-show-dates:hover {
        background: #e2e8f0;
      }

      /* Itinerary Timeline */
      .itinerary-timeline {
        position: relative;
        padding-left: 2rem;
      }

      .itinerary-timeline::before {
        content: "";
        position: absolute;
        top: 10px;
        bottom: 10px;
        left: 8px;
        width: 2px;
        background: #e2e8f0;
      }

      .itinerary-day-item {
        position: relative;
        margin-bottom: 2rem;
      }

      .itinerary-day-dot {
        position: absolute;
        left: -2rem;
        top: 4px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--orbit-primary);
        border: 3px solid #ffffff;
        box-shadow: 0 0 0 2px var(--orbit-primary);
      }

      .itinerary-day-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .itinerary-day-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin: 0;
      }

      .itinerary-day-time {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--orbit-primary);
        background: #f0f9ff;
        padding: 0.2rem 0.6rem;
        border-radius: var(--orbit-radius-full);
      }

      /* Inclusions / Exclusions Split */
      .includes-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }

      .includes-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .includes-list li {
        font-size: 0.95rem;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
      }

      .includes-list li.included i {
        color: #10b981;
        margin-top: 4px;
      }

      .includes-list li.excluded i {
        color: #ef4444;
        margin-top: 4px;
      }

      /* Highlights Grid */
      .highlights-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .highlight-pill {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 0.9rem 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 600;
        color: var(--orbit-dark);
      }

      .highlight-pill i {
        color: var(--orbit-accent);
        font-size: 1.1rem;
      }

      /* Photo Gallery Carousel */
      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .gallery-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: var(--orbit-radius-md);
        transition: var(--orbit-transition);
        cursor: pointer;
      }

      .gallery-img:hover {
        transform: scale(1.04);
        box-shadow: var(--orbit-shadow-md);
      }

      /* Sticky Booking Sidebar */
      .booking-sidebar-sticky {
        position: sticky;
        top: 100px;
      }

      .price-hero-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: white;
        border-radius: var(--orbit-radius-lg);
        padding: 2.5rem 2rem;
        text-align: center;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 1.5rem;
      }

      .price-amount {
        font-size: 3.2rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        color: #ffffff;
        line-height: 1;
        margin-bottom: 0.4rem;
      }

      .price-per-person {
        font-size: 0.95rem;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 2rem;
      }

      .btn-book-primary {
        background: linear-gradient(135deg, var(--orbit-accent), var(--orbit-accent-hover));
        color: white;
        border: none;
        width: 100%;
        padding: 1.1rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 800;
        font-size: 1.05rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        transition: var(--orbit-transition);
        box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4);
        margin-bottom: 1rem;
      }

      .btn-book-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(249, 115, 22, 0.55);
        color: white;
      }

      .btn-enquire-secondary {
        background: rgba(255, 255, 255, 0.1);
        border: 1.5px solid rgba(255, 255, 255, 0.3);
        color: white;
        width: 100%;
        padding: 0.9rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: var(--orbit-transition);
      }

      .btn-enquire-secondary:hover {
        background: #ffffff;
        color: var(--orbit-dark);
      }

      /* Star Rating Review Form */
      .star-rating {
        display: inline-flex;
        gap: 6px;
        font-size: 2rem;
        color: #cbd5e1;
        cursor: pointer;
      }

      .star.active, .star.hovered {
        color: #f59e0b;
      }

      .submit-review-btn {
        background: var(--orbit-primary);
        color: white;
        border: none;
        padding: 0.9rem 2rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        cursor: pointer;
        transition: var(--orbit-transition);
      }

      .submit-review-btn:disabled {
        background: #cbd5e1;
        cursor: not-allowed;
      }

      .submit-review-btn:not(:disabled):hover {
        background: var(--orbit-primary-dark);
        transform: translateY(-2px);
      }

      @media (max-width: 991px) {
        .detail-title {
          font-size: 2.5rem;
        }
        .metrics-strip {
          grid-template-columns: repeat(2, 1fr);
        }
        .includes-grid {
          grid-template-columns: 1fr;
        }
        .highlights-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body class="detail-page">
    <%- include("partials/nav") %>

    <!-- Hero Header -->
    <section class="detail-hero">
      <div class="container">
        <div class="detail-hero-content">
          <div class="detail-badge-pill">
            <i class="fas fa-mountain"></i>
            <span><%= tour.difficulty || 'Signature Expedition' %></span>
          </div>

          <h1 class="detail-title"><%= tour.name %></h1>

          <div class="detail-hero-meta">
            <div class="detail-meta-item">
              <i class="fas fa-map-marker-alt"></i>
              <span><%= tour.location %></span>
            </div>
            <div class="detail-meta-item">
              <i class="far fa-clock"></i>
              <span><%= tour.duration %></span>
            </div>
            <div class="detail-meta-item">
              <i class="fas fa-users"></i>
              <span>Max <%= tour.maxGroupSize || '20' %> Travelers</span>
            </div>
            <div class="detail-meta-item">
              <i class="fas fa-star text-warning"></i>
              <span><%= tour.ratingsAverage || '4.9' %> Rating</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content & Booking Layout -->
    <main class="detail-main">
      <div class="container">
        <div class="row g-4">
          <!-- Left Main Body Column -->
          <div class="col-lg-8">
            <!-- Quick Metrics Overview -->
            <div class="metrics-strip">
              <div class="metric-box">
                <div class="metric-box-icon"><i class="far fa-clock"></i></div>
                <div class="metric-box-label">Duration</div>
                <div class="metric-box-val"><%= tour.duration %></div>
              </div>
              <div class="metric-box">
                <div class="metric-box-icon"><i class="fas fa-hiking"></i></div>
                <div class="metric-box-label">Difficulty</div>
                <div class="metric-box-val"><%= tour.difficulty || 'Moderate' %></div>
              </div>
              <div class="metric-box">
                <div class="metric-box-icon"><i class="fas fa-users"></i></div>
                <div class="metric-box-label">Group Size</div>
                <div class="metric-box-val">Max <%= tour.maxGroupSize || '20' %></div>
              </div>
              <div class="metric-box">
                <div class="metric-box-icon"><i class="fas fa-map-pin"></i></div>
                <div class="metric-box-label">Departs From</div>
                <div class="metric-box-val"><%= tour.startLocation || tour.location %></div>
              </div>
            </div>

            <!-- Overview Card -->
            <div class="detail-card">
              <h2 class="detail-card-title">
                <i class="fas fa-compass"></i> Expedition Overview
              </h2>
              <p style="font-size: 1.05rem; line-height: 1.8; color: #334155;">
                <%= tour.overview %>
              </p>
            </div>

            <!-- Available Departure Dates -->
            <% if (tour.availableDates && tour.availableDates.length > 0) { %>
              <div class="detail-card">
                <h2 class="detail-card-title">
                  <i class="fas fa-calendar-alt"></i> Available Departure Dates
                </h2>
                <div class="dates-grid">
                  <% tour.availableDates.slice(0, 4).forEach((date) => { 
                    const dateObj = new Date(date);
                    const formattedDate = dateObj.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
                  %>
                    <div class="date-badge-pill">
                      <i class="fas fa-calendar-check"></i>
                      <span><%= formattedDate %></span>
                    </div>
                  <% }) %>
                </div>

                <% if (tour.availableDates.length > 4) { %>
                  <div class="dates-grid" id="hiddenDates" style="display: none; margin-top: 1rem;">
                    <% tour.availableDates.slice(4).forEach((date) => { 
                      const dateObj = new Date(date);
                      const formattedDate = dateObj.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
                    %>
                      <div class="date-badge-pill">
                        <i class="fas fa-calendar-check"></i>
                        <span><%= formattedDate %></span>
                      </div>
                    <% }) %>
                  </div>

                  <button class="btn-show-dates mt-3" id="showMoreBtn" onclick="toggleDates()">
                    <i class="fas fa-chevron-down" id="btnIcon"></i>
                    <span id="btnText">Show All Dates (<%= tour.availableDates.length - 4 %> more)</span>
                  </button>
                <% } %>
              </div>
            <% } %>

            <!-- Tour Highlights -->
            <% if (tour.highlights && tour.highlights.length > 0) { %>
              <div class="detail-card">
                <h2 class="detail-card-title">
                  <i class="fas fa-sparkles"></i> Expedition Highlights
                </h2>
                <div class="highlights-grid">
                  <% tour.highlights.forEach(highlight => { %>
                    <div class="highlight-pill">
                      <i class="fas fa-check-circle"></i>
                      <span><%= highlight %></span>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Detailed Day-by-Day Itinerary -->
            <% if (tour.itinerary && tour.itinerary.length > 0) { %>
              <div class="detail-card">
                <h2 class="detail-card-title">
                  <i class="fas fa-route"></i> Daily Itinerary
                </h2>
                <div class="itinerary-timeline">
                  <% tour.itinerary.forEach((day, index) => { %>
                    <div class="itinerary-day-item">
                      <div class="itinerary-day-dot"></div>
                      <div class="itinerary-day-header">
                        <h4 class="itinerary-day-title">Day <%= index + 1 %>: <%= day.title %></h4>
                        <span class="itinerary-day-time"><i class="far fa-clock me-1"></i><%= day.time || 'Full Day' %></span>
                      </div>
                      <p style="color: #475569; line-height: 1.7; margin: 0;">
                        <%= day.description %>
                      </p>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Gallery Images -->
            <% if (tour.moreImages && tour.moreImages.length > 0) { %>
              <div class="detail-card">
                <h2 class="detail-card-title">
                  <i class="fas fa-camera"></i> Expedition Photo Gallery
                </h2>
                <div class="gallery-grid">
                  <% tour.moreImages.forEach((image, index) => { %>
                    <img
                      src="<%= image %>"
                      alt="Photo <%= index + 1 %>"
                      class="gallery-img"
                      loading="lazy"
                    />
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Included & Excluded -->
            <div class="detail-card">
              <h2 class="detail-card-title">
                <i class="fas fa-clipboard-check"></i> Inclusions & Exclusions
              </h2>
              <div class="includes-grid">
                <% if (tour.included && tour.included.length > 0) { %>
                  <div>
                    <h5 style="color: #10b981; font-weight: 700; margin-bottom: 1rem;">
                      <i class="fas fa-check-circle me-1"></i> What's Included
                    </h5>
                    <ul class="includes-list">
                      <% tour.included.forEach(item => { %>
                        <li class="included"><i class="fas fa-check"></i><span><%= item %></span></li>
                      <% }) %>
                    </ul>
                  </div>
                <% } %>

                <% if (tour.excluded && tour.excluded.length > 0) { %>
                  <div>
                    <h5 style="color: #ef4444; font-weight: 700; margin-bottom: 1rem;">
                      <i class="fas fa-times-circle me-1"></i> What's Not Included
                    </h5>
                    <ul class="includes-list">
                      <% tour.excluded.forEach(item => { %>
                        <li class="excluded"><i class="fas fa-times"></i><span><%= item %></span></li>
                      <% }) %>
                    </ul>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Verified Traveler Reviews -->
            <div class="detail-card">
              <h2 class="detail-card-title">
                <i class="fas fa-star text-warning"></i> Verified Traveler Reviews
              </h2>

              <% if (locals.error) { %>
                <div class="alert alert-danger mb-3" style="border-radius: 12px;">
                  <i class="fas fa-exclamation-circle me-2"></i> <%= locals.error %>
                </div>
              <% } %>
              <% if (locals.success) { %>
                <div class="alert alert-success mb-3" style="border-radius: 12px;">
                  <i class="fas fa-check-circle me-2"></i> <%= locals.success %>
                </div>
              <% } %>

              <% if (locals.canReview) { %>
                <div class="p-3 mb-4 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                  <h4 style="font-size: 1.15rem; font-weight: 700; color: var(--orbit-dark); margin-bottom: 1rem;">
                    Rate & Review Your Trip
                  </h4>

                  <form
                    method="POST"
                    action="/tour/<%= tour.name.replace(/\s+/g, '-').toLowerCase() %>/comment"
                    enctype="multipart/form-data"
                  >
                    <!-- Star Rating -->
                    <div class="mb-3">
                      <label style="display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">Your Rating *</label>
                      <div class="d-flex align-items-center gap-3">
                        <div class="star-rating" id="starRating">
                          <span class="star" data-rating="1">★</span>
                          <span class="star" data-rating="2">★</span>
                          <span class="star" data-rating="3">★</span>
                          <span class="star" data-rating="4">★</span>
                          <span class="star" data-rating="5">★</span>
                        </div>
                        <div class="rating-feedback" style="font-size: 0.95rem; font-weight: 600;">
                          <span class="rating-emoji">😊</span>
                          <span class="rating-text text-muted">Click to rate</span>
                        </div>
                      </div>
                      <input type="hidden" name="rating" id="ratingValue" required />
                    </div>

                    <!-- Review Content -->
                    <div class="mb-3">
                      <label for="content" style="display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">Your Review *</label>
                      <textarea
                        id="content"
                        name="content"
                        rows="4"
                        placeholder="Share your trip experiences, highlights, and travel tips for future adventurers..."
                        class="form-control"
                        style="border-radius: 12px;"
                        required
                      ></textarea>
                    </div>

                    <!-- Photos Upload -->
                    <div class="mb-3">
                      <label style="display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-camera me-1"></i> Add Trip Photos (Optional)
                      </label>
                      <input
                        type="file"
                        name="photos"
                        multiple
                        accept="image/*"
                        class="form-control"
                        style="border-radius: 10px;"
                      />
                      <small class="text-muted">You can upload up to 5 photos from your journey.</small>
                    </div>

                    <button type="submit" class="submit-review-btn" disabled id="submitBtn">
                      <i class="fas fa-paper-plane me-1"></i> Post Verified Review
                    </button>
                  </form>
                </div>
              <% } else { %>
                <div class="p-3 mb-4 rounded-3" style="background: #f8fafc; border-left: 4px solid var(--orbit-primary);">
                  <h5 style="margin: 0 0 4px 0; color: var(--orbit-primary); font-weight: 700; font-size: 0.95rem;">
                    <i class="fas fa-shield-alt me-1"></i> Verified Reviews Policy
                  </h5>
                  <p style="margin: 0; color: #64748b; font-size: 0.9rem;">
                    <%= locals.reviewRestrictionReason || "Only customers who have booked this expedition and completed their trip can submit a review." %>
                  </p>
                </div>
              <% } %>

              <!-- Comments Stream -->
              <% if (comments && comments.length > 0) { %>
                <% comments.forEach(comment => { %>
                  <div class="p-3 mb-3 rounded-3" style="border: 1px solid #f1f5f9; background: #ffffff;">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <div style="width: 38px; height: 38px; border-radius: 50%; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                          <%= comment.createdBy ? comment.createdBy.fullName.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                          <div style="font-weight: 700; color: var(--orbit-dark);"><%= comment.createdBy ? comment.createdBy.fullName : 'Verified Explorer' %></div>
                          <small class="text-muted"><%= new Date(comment.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></small>
                        </div>
                      </div>
                      <div style="color: #f59e0b; font-size: 1.1rem;">
                        <% for(let i = 1; i <= 5; i++) { %>
                          <%= comment.rating >= i ? '★' : '☆' %>
                        <% } %>
                      </div>
                    </div>
                    <p style="color: #334155; line-height: 1.6; margin-bottom: 0.5rem;">
                      <%= comment.content %>
                    </p>
                    <% if (comment.photos && comment.photos.length > 0) { %>
                      <div class="d-flex gap-2 flex-wrap mt-2">
                        <% comment.photos.forEach(photo => { %>
                          <img
                            src="<%= photo %>"
                            alt="Review photo"
                            style="width: 75px; height: 75px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;"
                          />
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-center py-4 text-muted">
                  <i class="far fa-comments fa-2x mb-2 opacity-50"></i>
                  <p>No traveler reviews yet for this expedition.</p>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Right Sticky Booking Sidebar -->
          <div class="col-lg-4">
            <div class="booking-sidebar-sticky">
              <!-- Price Card -->
              <div class="price-hero-card">
                <div class="price-amount">
                  ₹<%= (tour.price != null ? tour.price : 0).toLocaleString('en-IN') %>
                </div>
                <div class="price-per-person">All-inclusive per traveler</div>

                <button class="btn-book-primary" onclick="proceedToBooking()">
                  <i class="fas fa-calendar-check"></i>
                  <span>Reserve & Book Now</span>
                </button>

                <button class="btn-enquire-secondary" onclick="bookTour()">
                  <i class="fas fa-envelope"></i>
                  <span>Inquire with Specialist</span>
                </button>

                <div class="mt-3 text-muted" style="font-size: 0.8rem; opacity: 0.85;">
                  <i class="fas fa-shield-alt me-1 text-primary"></i> 100% Secure & Razorpay Protected
                </div>
              </div>

              <!-- Tour Guides Profile -->
              <% if (tour.guides && tour.guides.length > 0) { %>
                <div class="detail-card">
                  <h4 style="font-size: 1.15rem; font-weight: 800; color: var(--orbit-dark); margin-bottom: 1.2rem;">
                    <i class="fas fa-user-tie text-primary me-2"></i> Lead Expedition Guides
                  </h4>
                  <% tour.guides.forEach(guide => { %>
                    <div class="d-flex align-items-center gap-3 mb-3">
                      <div style="width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark)); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; flex-shrink: 0;">
                        <%= guide.name.charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <h5 style="margin: 0; font-size: 1rem; font-weight: 700; color: var(--orbit-dark);"><%= guide.name %></h5>
                        <p style="margin: 0; font-size: 0.85rem; color: #64748b;"><%= guide.role || 'Certified Expedition Leader' %></p>
                        <div style="color: #f59e0b; font-size: 0.8rem;">★★★★★</div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>

              <!-- Support Card -->
              <div class="detail-card">
                <h4 style="font-size: 1.15rem; font-weight: 800; color: var(--orbit-dark); margin-bottom: 1.2rem;">
                  <i class="fas fa-headset text-primary me-2"></i> Have Questions?
                </h4>
                <p style="font-size: 0.88rem; color: #64748b; margin-bottom: 1rem;">
                  Our concierge team is available 24/7 to customize dates, group bookings, or flight transfers.
                </p>
                <div class="d-flex align-items-center gap-2 mb-2" style="font-size: 0.95rem; font-weight: 700;">
                  <i class="fas fa-phone text-primary"></i>
                  <span>+91 98765 43210</span>
                </div>
                <div class="d-flex align-items-center gap-2" style="font-size: 0.95rem; font-weight: 700;">
                  <i class="fas fa-envelope text-primary"></i>
                  <span>orbitrushtourism@gmail.com</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>

    <script>
      function toggleDates() {
        const hiddenDates = document.getElementById("hiddenDates");
        const btn = document.getElementById("showMoreBtn");
        const btnText = document.getElementById("btnText");
        const btnIcon = document.getElementById("btnIcon");

        if (hiddenDates.style.display === "none") {
          hiddenDates.style.display = "grid";
          btnText.textContent = "Show Fewer Dates";
          btnIcon.className = "fas fa-chevron-up";
        } else {
          hiddenDates.style.display = "none";
          const totalHidden = document.querySelectorAll("#hiddenDates .date-badge-pill").length;
          btnText.textContent = `Show All Dates (${totalHidden} more)`;
          btnIcon.className = "fas fa-chevron-down";
        }
      }

      function proceedToBooking() {
        window.location.href = `/booking/book/<%= tour._id %>`;
      }

      function bookTour() {
        window.location.href = "/tour/enquire";
      }

      document.addEventListener("DOMContentLoaded", function () {
        const stars = document.querySelectorAll(".star");
        const ratingValue = document.getElementById("ratingValue");
        const ratingEmoji = document.querySelector(".rating-emoji");
        const ratingText = document.querySelector(".rating-text");
        const submitBtn = document.getElementById("submitBtn");

        const ratingData = {
          1: { emoji: "😞", text: "Terrible" },
          2: { emoji: "😐", text: "Poor" },
          3: { emoji: "🙂", text: "Average" },
          4: { emoji: "😊", text: "Good" },
          5: { emoji: "🤩", text: "Exceptional" },
        };

        if (stars.length > 0) {
          stars.forEach((star) => {
            star.addEventListener("click", function () {
              const rating = parseInt(this.dataset.rating);
              if (ratingValue) ratingValue.value = rating;

              stars.forEach((s, idx) => {
                s.classList.toggle("active", idx < rating);
              });

              if (ratingEmoji && ratingText && ratingData[rating]) {
                ratingEmoji.textContent = ratingData[rating].emoji;
                ratingText.textContent = ratingData[rating].text;
              }

              if (submitBtn) submitBtn.disabled = false;
            });

            star.addEventListener("mouseenter", function () {
              const rating = parseInt(this.dataset.rating);
              stars.forEach((s, idx) => {
                s.classList.toggle("hovered", idx < rating);
              });
            });

            star.addEventListener("mouseleave", function () {
              stars.forEach((s) => s.classList.remove("hovered"));
            });
          });
        }
      });
    </script>
  </body>
</html>
