<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Explore Luxury Expeditions | OrbitRush Tourism</title>
    <style>
      .tours-page {
        background-color: var(--orbit-light);
        min-height: 100vh;
      }

      /* Hero Header */
      .tours-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0369a1 100%);
        color: white;
        padding: 5rem 0 6rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .tours-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(56, 189, 248, 0.15) 0%, transparent 60%);
        pointer-events: none;
      }

      .tours-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #38bdf8;
        padding: 0.45rem 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1.2rem;
      }

      .tours-hero-title {
        font-size: 3.5rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: #ffffff;
      }

      .tours-hero-subtitle {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 640px;
        margin: 0 auto 2.5rem;
        line-height: 1.6;
      }

      /* Interactive Live Search Bar */
      .tours-search-wrapper {
        max-width: 580px;
        margin: 0 auto;
        position: relative;
        z-index: 10;
      }

      .tours-search-box {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: var(--orbit-radius-full);
        padding: 0.5rem 0.6rem 0.5rem 1.5rem;
        display: flex;
        align-items: center;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.5);
      }

      .tours-search-input {
        flex: 1;
        border: none;
        background: transparent;
        font-size: 1rem;
        color: var(--orbit-dark);
        outline: none;
        font-family: inherit;
      }

      .tours-search-input::placeholder {
        color: #94a3b8;
      }

      .tours-search-btn {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: white;
        border: none;
        border-radius: var(--orbit-radius-full);
        padding: 0.8rem 1.6rem;
        font-weight: 700;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: var(--orbit-transition);
      }

      .tours-search-btn:hover {
        transform: scale(1.04);
        box-shadow: 0 8px 20px rgba(2, 132, 199, 0.4);
      }

      /* Tours Listing Main Container */
      .tours-main-section {
        padding: 4rem 0 6rem;
        margin-top: -2rem;
        position: relative;
        z-index: 5;
      }

      .tours-stats-bar {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 1.25rem 2rem;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-sm);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .tours-count-label {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--orbit-dark);
      }

      .tours-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }

      @media (max-width: 1024px) {
        .tours-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 767px) {
        .tours-grid {
          grid-template-columns: 1fr;
        }
        .tours-hero-title {
          font-size: 2.5rem;
        }
      }

      /* Tour Expedition Card */
      .expedition-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-md);
        overflow: hidden;
        border: 1px solid rgba(226, 232, 240, 0.9);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        transition: var(--orbit-transition);
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .expedition-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
        border-color: rgba(2, 132, 199, 0.3);
      }

      .expedition-img-wrap {
        position: relative;
        height: 260px;
        overflow: hidden;
      }

      .expedition-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .expedition-card:hover .expedition-img {
        transform: scale(1.08);
      }

      .expedition-price-badge {
        position: absolute;
        bottom: 14px;
        right: 14px;
        background: rgba(15, 23, 42, 0.88);
        backdrop-filter: blur(10px);
        color: #ffffff;
        padding: 0.45rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 1.1rem;
        font-weight: 800;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }

      .expedition-body {
        padding: 1.8rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
      }

      .expedition-location {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--orbit-primary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.4rem;
      }

      .expedition-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--orbit-dark);
        line-height: 1.3;
        margin-bottom: 0.8rem;
      }

      .expedition-overview {
        color: #64748b;
        font-size: 0.92rem;
        line-height: 1.6;
        margin-bottom: 1.2rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .expedition-pills {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .expedition-tag {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.3rem 0.75rem;
        border-radius: var(--orbit-radius-full);
        background: #f1f5f9;
        color: #475569;
      }

      .expedition-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.2rem;
        border-top: 1px solid #f1f5f9;
      }

      .expedition-duration {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 600;
      }

      .btn-explore {
        background: linear-gradient(135deg, var(--orbit-primary), var(--orbit-primary-dark));
        color: #ffffff;
        padding: 0.65rem 1.3rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.88rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: var(--orbit-transition);
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3);
      }

      .btn-explore:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(2, 132, 199, 0.45);
        color: #ffffff;
      }

      /* Floating Admin Quick Access Button */
      .orbit-admin-fab {
        position: fixed;
        bottom: 2rem;
        left: 2rem;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        box-shadow: 0 10px 30px rgba(239, 68, 68, 0.45);
        transition: var(--orbit-transition);
        z-index: 1000;
        text-decoration: none;
      }

      .orbit-admin-fab:hover {
        transform: scale(1.1) rotate(15deg);
        box-shadow: 0 15px 40px rgba(239, 68, 68, 0.6);
        color: white;
      }

      /* Empty State */
      .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        border: 1px dashed #cbd5e1;
        grid-column: 1 / -1;
      }

      .empty-icon {
        font-size: 4rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
      }
    </style>
  </head>

  <body class="tours-page">
    <%- include("partials/nav") %>

    <!-- Hero Section with Search -->
    <section class="tours-hero">
      <div class="container">
        <div class="tours-hero-badge">
          <i class="fas fa-globe-americas"></i> Curated Destinations
        </div>
        <h1 class="tours-hero-title">Explore World Expeditions</h1>
        <p class="tours-hero-subtitle">
          Handcrafted adventures for the intrepid soul. Find your next transformative journey across our global portfolio.
        </p>

        <!-- Live Search Input -->
        <div class="tours-search-wrapper">
          <div class="tours-search-box">
            <i class="fas fa-search text-muted me-2"></i>
            <input
              type="text"
              id="tourSearchInput"
              class="tours-search-input"
              placeholder="Search by tour name, country, or location..."
              autocomplete="off"
            />
            <button class="tours-search-btn" id="tourSearchBtn">
              <span>Find Tour</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Tours Grid Section -->
    <main class="tours-main-section">
      <div class="container">
        <!-- Results Bar -->
        <div class="tours-stats-bar">
          <div class="tours-count-label">
            <i class="fas fa-compass text-primary me-2"></i>
            <span id="resultsCount"><%= (tours && tours.length) || 0 %></span> Available Expeditions
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted" style="font-size: 0.88rem; font-weight: 600;">All Inclusive & Guided</span>
          </div>
        </div>

        <% if (tours && tours.length > 0) { %>
          <div class="tours-grid" id="toursGrid">
            <% tours.forEach(tour => { %>
              <article
                class="expedition-card tour-item"
                data-name="<%= (tour.name || '').toLowerCase() %>"
                data-location="<%= (tour.location || '').toLowerCase() %>"
                data-overview="<%= (tour.overview || '').toLowerCase() %>"
              >
                <div class="expedition-img-wrap">
                  <img
                    src="<%= tour.coverImage || '/images/default-tour.jpg' %>"
                    alt="<%= tour.name %>"
                    class="expedition-img"
                    loading="eager"
                    decoding="sync"
                  />
                  <div class="expedition-price-badge">
                    ₹<%= (tour.price != null ? tour.price : 0).toLocaleString('en-IN') %>
                  </div>
                </div>

                <div class="expedition-body">
                  <div>
                    <div class="expedition-location">
                      <i class="fas fa-map-marker-alt"></i>
                      <%= tour.location %>
                    </div>

                    <h2 class="expedition-title"><%= tour.name %></h2>

                    <p class="expedition-overview"><%= tour.overview %></p>

                    <div class="expedition-pills">
                      <span class="expedition-tag"><i class="fas fa-shield-alt text-primary me-1"></i> Guided</span>
                      <span class="expedition-tag"><i class="fas fa-hotel text-success me-1"></i> Luxury Stay</span>
                      <span class="expedition-tag"><i class="fas fa-utensils text-warning me-1"></i> Meals</span>
                    </div>
                  </div>

                  <div class="expedition-footer">
                    <div class="expedition-duration">
                      <i class="far fa-clock"></i>
                      <span><%= tour.duration %></span>
                    </div>

                    <a
                      href="/tour/<%= tour.name.replace(/\s+/g, '-').toLowerCase() %>"
                      class="btn-explore"
                    >
                      <span>Details</span>
                      <i class="fas fa-arrow-right"></i>
                    </a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">
              <i class="fas fa-compass"></i>
            </div>
            <h2 style="font-size: 1.8rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
              New Expeditions Launching Soon
            </h2>
            <p style="color: #64748b; max-width: 480px; margin: 0 auto 1.5rem;">
              We are currently scouting extraordinary new itineraries. Stay tuned for upcoming departures.
            </p>
            <% if (user && user.role === 'ADMIN') { %>
              <a href="/tour/admin/create" class="btn-explore" style="padding: 0.8rem 1.8rem;">
                <i class="fas fa-plus"></i>
                <span>Create First Tour</span>
              </a>
            <% } %>
          </div>
        <% } %>
      </div>
    </main>

    <!-- Admin Floating Action Button -->
    <% if (user && user.role === 'ADMIN') { %>
      <a href="/tour/admin/dashboard" class="orbit-admin-fab" title="Admin Dashboard">
        <i class="fas fa-cog"></i>
      </a>
    <% } %>

    <%- include("partials/footer") %>
    <%- include("partials/scripts") %>

    <!-- Instant Client-Side Tour Filtering -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("tourSearchInput");
        const tourItems = document.querySelectorAll(".tour-item");
        const resultsCount = document.getElementById("resultsCount");

        if (searchInput) {
          searchInput.addEventListener("input", function () {
            const query = this.value.trim().toLowerCase();
            let visibleCount = 0;

            tourItems.forEach((item) => {
              const name = item.dataset.name || "";
              const location = item.dataset.location || "";
              const overview = item.dataset.overview || "";

              if (name.includes(query) || location.includes(query) || overview.includes(query)) {
                item.style.display = "flex";
                visibleCount++;
              } else {
                item.style.display = "none";
              }
            });

            if (resultsCount) {
              resultsCount.textContent = visibleCount;
            }
          });
        }
      });
    </script>
  </body>
</html>
