<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>OrbitRush — Luxury Expeditions & Curated Global Journeys</title>
    <style>
      /* Hero Section with Cinematic Canvas */
      .orbit-hero {
        position: relative;
        min-height: 92vh;
        display: flex;
        align-items: center;
        color: white;
        overflow: hidden;
        margin-top: -100px;
        padding: 140px 0 60px 0;
      }

      .orbit-hero-bg-wrapper {
        position: absolute;
        inset: 0;
        z-index: -2;
      }

      .orbit-hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0;
        transform: scale(1.04);
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 8s ease-out;
        will-change: opacity, transform;
      }

      .orbit-hero-bg.active {
        opacity: 1;
        transform: scale(1);
      }

      .orbit-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          rgba(15, 23, 42, 0.65) 0%,
          rgba(15, 23, 42, 0.4) 50%,
          rgba(15, 23, 42, 0.85) 100%
        );
        z-index: -1;
      }

      .orbit-hero-content {
        position: relative;
        z-index: 2;
        max-width: 860px;
        margin: 0 auto;
        text-align: center;
      }

      .orbit-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 0.5rem 1.2rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        animation: fadeInDown 0.8s ease-out;
      }

      .orbit-hero-title {
        font-size: 4rem;
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -0.03em;
        color: #ffffff;
        margin-bottom: 1.5rem;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }

      .orbit-hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 2.5rem;
        line-height: 1.7;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
        font-weight: 400;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
      }

      .orbit-hero-buttons {
        display: flex;
        gap: 1.25rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn-orbit-hero {
        padding: 1rem 2.2rem;
        font-size: 1.05rem;
        font-weight: 700;
        border-radius: var(--orbit-radius-full);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        transition: var(--orbit-transition);
      }

      .btn-orbit-primary {
        background: linear-gradient(135deg, var(--orbit-accent), var(--orbit-accent-hover));
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4);
        border: none;
      }

      .btn-orbit-primary:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 16px 40px rgba(249, 115, 22, 0.5);
        color: #ffffff;
      }

      .btn-orbit-glass {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(255, 255, 255, 0.4);
        color: #ffffff;
      }

      .btn-orbit-glass:hover {
        background: #ffffff;
        color: var(--orbit-dark);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(255, 255, 255, 0.3);
      }

      /* Hero Slide Indicators */
      .orbit-hero-indicators {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 10;
      }

      .indicator {
        width: 10px;
        height: 10px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.35);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .indicator.active {
        width: 32px;
        background: #ffffff;
        box-shadow: 0 0 12px rgba(255, 255, 255, 0.8);
      }

      /* Quick Search Bar Floating Under Hero */
      .orbit-search-strip {
        position: relative;
        z-index: 20;
        margin-top: -45px;
        margin-bottom: 4rem;
      }

      .orbit-search-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 1.25rem 1.8rem;
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(226, 232, 240, 0.8);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .orbit-search-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
        min-width: 200px;
      }

      .orbit-search-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(2, 132, 199, 0.1);
        color: var(--orbit-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
      }

      .orbit-search-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 2px;
      }

      .orbit-search-val {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--orbit-dark);
      }

      /* Featured Tours Section */
      .featured-section {
        padding: 4rem 0 6rem;
      }

      .section-header-wrap {
        text-align: center;
        max-width: 680px;
        margin: 0 auto 3.5rem;
      }

      .section-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(2, 132, 199, 0.08);
        color: var(--orbit-primary);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.4rem 1rem;
        border-radius: var(--orbit-radius-full);
        margin-bottom: 0.8rem;
      }

      .section-main-heading {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--orbit-dark);
        letter-spacing: -0.03em;
        margin-bottom: 0.8rem;
      }

      .section-subtitle-text {
        font-size: 1.1rem;
        color: #64748b;
        line-height: 1.6;
      }

      /* Carousel Architecture */
      .carousel-container {
        position: relative;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 10px;
      }

      .carousel-viewport {
        overflow: hidden;
        position: relative;
        width: 100%;
        padding: 10px 0 25px 0;
      }

      .carousel-track {
        display: flex;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
      }

      .carousel-slide {
        flex: 0 0 auto;
        padding: 0 12px;
        width: 33.3333%;
      }

      @media (max-width: 1024px) {
        .carousel-slide {
          width: 50%;
        }
      }

      @media (max-width: 767px) {
        .carousel-slide {
          width: 100%;
        }
      }

      /* Luxury Tour Cards */
      .tour-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(226, 232, 240, 0.85);
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
        transition: var(--orbit-transition);
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .tour-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.14);
        border-color: rgba(2, 132, 199, 0.3);
      }

      .tour-image-wrap {
        position: relative;
        height: 250px;
        overflow: hidden;
      }

      .tour-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .tour-card:hover .tour-image {
        transform: scale(1.08);
      }

      .tour-price-badge {
        position: absolute;
        bottom: 14px;
        right: 14px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(8px);
        color: #ffffff;
        padding: 0.4rem 0.9rem;
        border-radius: var(--orbit-radius-full);
        font-size: 1.05rem;
        font-weight: 800;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }

      .tour-card-body {
        padding: 1.6rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .tour-location {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--orbit-primary);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .tour-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 1rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.5rem;
      }

      .btn-tour {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: var(--orbit-dark);
        padding: 0.75rem 1.25rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: var(--orbit-transition);
        margin-top: 0.5rem;
      }

      .btn-tour:hover {
        background: var(--orbit-primary);
        border-color: var(--orbit-primary);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(2, 132, 199, 0.35);
      }

      /* Carousel Controls */
      .carousel-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .carousel-arrow {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--orbit-dark);
        cursor: pointer;
        transition: var(--orbit-transition);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
      }

      .carousel-arrow:hover {
        background: var(--orbit-primary);
        border-color: var(--orbit-primary);
        color: #ffffff;
        transform: scale(1.08);
      }

      .carousel-dots {
        display: flex;
        gap: 8px;
      }

      .carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #cbd5e1;
        cursor: pointer;
        transition: all 0.3s;
      }

      .carousel-dot.active {
        width: 24px;
        border-radius: 9999px;
        background: var(--orbit-primary);
      }

      /* Why Choose Us Section */
      .why-choose-section {
        padding: 6rem 0;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        position: relative;
      }

      .features-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        margin-top: 3.5rem;
      }

      .feature-item {
        background: #ffffff;
        border-radius: 20px;
        padding: 2.5rem 1.8rem;
        text-align: center;
        border: 1px solid rgba(226, 232, 240, 0.9);
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
        transition: var(--orbit-transition);
      }

      .feature-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.1);
        border-color: var(--orbit-primary-light);
      }

      .feature-icon-box {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        background: rgba(2, 132, 199, 0.1);
        color: var(--orbit-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1.5rem;
        transition: var(--orbit-transition);
      }

      .feature-item:hover .feature-icon-box {
        background: var(--orbit-primary);
        color: #ffffff;
        transform: scale(1.1) rotate(5deg);
      }

      .feature-item h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--orbit-dark);
        margin-bottom: 0.75rem;
        line-height: 1.3;
      }

      .feature-item p {
        color: #64748b;
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0;
      }

      /* Empty State */
      .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: #ffffff;
        border-radius: 20px;
        border: 1px dashed #cbd5e1;
      }

      .empty-state i {
        font-size: 3.5rem;
        color: #94a3b8;
        margin-bottom: 1rem;
      }

      @media (max-width: 991px) {
        .orbit-hero-title {
          font-size: 2.8rem;
        }
        .features-row {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 600px) {
        .orbit-hero-title {
          font-size: 2.2rem;
        }
        .features-row {
          grid-template-columns: 1fr;
        }
        .orbit-hero-buttons {
          flex-direction: column;
        }
        .btn-orbit-hero {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>

  <body>
    <%- include("partials/nav") %>

    <!-- Hero Section with Dynamic Slideshow -->
    <section class="orbit-hero">
      <div class="orbit-hero-bg-wrapper">
        <div
          class="orbit-hero-bg active"
          style="
            background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
          "
        ></div>
        <div
          class="orbit-hero-bg"
          data-bg="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
        ></div>
        <div
          class="orbit-hero-bg"
          data-bg="https://images.unsplash.com/photo-1469474968028-56623f02e42e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
        ></div>
        <div
          class="orbit-hero-bg"
          data-bg="https://images.unsplash.com/photo-1439066615861-d1af74d74000?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
        ></div>
        <div
          class="orbit-hero-bg"
          data-bg="https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
        ></div>
        <div
          class="orbit-hero-bg"
          data-bg="https://images.unsplash.com/photo-1506197603052-3cc9c3a201bd?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
        ></div>
        <div
          class="orbit-hero-bg"
          data-bg="https://images.unsplash.com/photo-1440342359743-84fcb8c21f21?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
        ></div>
      </div>

      <div class="orbit-hero-overlay"></div>

      <!-- Slide Indicators -->
      <div class="orbit-hero-indicators">
        <div class="indicator active" data-slide="0"></div>
        <div class="indicator" data-slide="1"></div>
        <div class="indicator" data-slide="2"></div>
        <div class="indicator" data-slide="3"></div>
        <div class="indicator" data-slide="4"></div>
        <div class="indicator" data-slide="5"></div>
        <div class="indicator" data-slide="6"></div>
      </div>

      <div class="container">
        <div class="orbit-hero-content">
          <div class="orbit-hero-badge">
            <i class="fas fa-sparkles text-warning"></i>
            <span>Curated Expeditions Worldwide</span>
          </div>

          <h1 class="orbit-hero-title">Discover the World Beyond Horizons</h1>
          <p class="orbit-hero-subtitle">
            Immerse yourself in extraordinary journeys crafted with obsessive attention to luxury, culture, and untamed discovery.
          </p>

          <div class="orbit-hero-buttons">
            <a href="/tour" class="btn-orbit-hero btn-orbit-primary">
              <i class="fas fa-compass"></i>
              <span>Explore All Tours</span>
            </a>

            <% if (user && user.role === 'ADMIN') { %>
              <a href="/tour/admin/dashboard" class="btn-orbit-hero btn-orbit-glass">
                <i class="fas fa-cog"></i>
                <span>Admin Dashboard</span>
              </a>
            <% } else if (user) { %>
              <span class="btn-orbit-hero btn-orbit-glass" style="cursor: default">
                <i class="fas fa-user-check"></i>
                <span>Welcome back, <%= user.fullName.split(' ')[0] %></span>
              </span>
            <% } else { %>
              <a href="/user/signin" class="btn-orbit-hero btn-orbit-glass">
                <i class="fas fa-sign-in-alt"></i>
                <span>Member Sign In</span>
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Search / Discover Highlights Floating Bar -->
    <div class="container">
      <div class="orbit-search-strip">
        <div class="orbit-search-card">
          <div class="orbit-search-item">
            <div class="orbit-search-icon">
              <i class="fas fa-map-marked-alt"></i>
            </div>
            <div>
              <div class="orbit-search-label">Handcrafted Tours</div>
              <div class="orbit-search-val"><%= tours.length %> Luxury Packages</div>
            </div>
          </div>

          <div class="orbit-search-item">
            <div class="orbit-search-icon" style="background: rgba(249, 115, 22, 0.1); color: var(--orbit-accent);">
              <i class="fas fa-user-shield"></i>
            </div>
            <div>
              <div class="orbit-search-label">Verified Escorts</div>
              <div class="orbit-search-val">100% Certified Guides</div>
            </div>
          </div>

          <div class="orbit-search-item">
            <div class="orbit-search-icon" style="background: rgba(2, 132, 199, 0.12); color: #0284c7;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: block;">
                <path d="m22.436 0-11.91 7.773-1.174 4.276 6.625-4.323L12.35 24h4.483l6.78-14.887zM6.559 13.91l-1.922 6.973 5.438-3.55 1.173-4.256z"/>
              </svg>
            </div>
            <div>
              <div class="orbit-search-label">Payment Security</div>
              <div class="orbit-search-val">Razorpay Protected</div>
            </div>
          </div>

          <a href="/tour/enquire" class="btn-orbit-hero btn-orbit-primary" style="padding: 0.75rem 1.6rem; font-size: 0.92rem;">
            <span>Enquiry</span>
            <i class="fas fa-paper-plane ms-1"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Featured Tours Carousel Section -->
    <section class="featured-section">
      <div class="container">
        <div class="section-header-wrap">
          <div class="section-badge-pill">
            <i class="fas fa-star"></i> Hand-Picked Adventures
          </div>
          <h2 class="section-main-heading">Featured Expeditions</h2>
          <p class="section-subtitle-text">
            Step outside the ordinary with our most requested luxury travel experiences across mountain peaks, azure coastlines, and ancient wonders.
          </p>
        </div>

        <% if (tours.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-map-signs"></i>
            <h3>New Expeditions Coming Soon</h3>
            <p class="text-muted">Our travel curators are assembling exceptional new itineraries.</p>
            <% if (user && user.role === 'ADMIN') { %>
              <a href="/tour/admin/create" class="btn-orbit-hero btn-orbit-primary mt-3">
                <i class="fas fa-plus"></i> Create First Tour
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="carousel-container">
            <div class="carousel-viewport">
              <div class="carousel-track" id="carouselTrack">
                <% tours.forEach(function(tour, index) { %>
                  <div class="carousel-slide">
                    <article class="tour-card">
                      <div class="tour-image-wrap">
                        <img
                          src="<%= tour.coverImage || '/images/default-tour.jpg' %>"
                          alt="<%= tour.name %>"
                          class="tour-image"
                          loading="eager"
                          decoding="sync"
                        />
                        <div class="tour-price-badge">
                          ₹<%= (tour.price != null ? tour.price : 0).toLocaleString('en-IN') %>
                        </div>
                      </div>

                      <div class="tour-card-body">
                        <div>
                          <div class="tour-location">
                            <i class="fas fa-map-marker-alt"></i>
                            <%= tour.location %>
                          </div>
                          <h3 class="tour-title"><%= tour.name %></h3>
                        </div>

                        <a
                          href="/tour/<%= tour.name.replace(/\s+/g, '-').toLowerCase() %>"
                          class="btn-tour"
                        >
                          <span>Explore Itinerary</span>
                          <i class="fas fa-arrow-right"></i>
                        </a>
                      </div>
                    </article>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Carousel Navigation Controls -->
            <div class="carousel-nav">
              <button class="carousel-arrow" id="prevBtn" aria-label="Previous Slide">
                <i class="fas fa-chevron-left"></i>
              </button>
              <div class="carousel-dots" id="carouselDots">
                <% var maxDots = tours.length > 3 ? tours.length - 2 : tours.length; %>
                <% for (let i = 0; i < maxDots; i++) { %>
                  <div
                    class="carousel-dot <%= i === 0 ? 'active' : '' %>"
                    data-slide="<%= i %>"
                  ></div>
                <% } %>
              </div>
              <button class="carousel-arrow" id="nextBtn" aria-label="Next Slide">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Why Choose OrbitRush Section -->
    <section class="why-choose-section">
      <div class="container">
        <div class="section-header-wrap">
          <div class="section-badge-pill">
