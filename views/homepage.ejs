    <!-- Carousel & Hero Slideshow Script -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Hero Background Slideshow
        const backgrounds = document.querySelectorAll(".orbit-hero-bg");
        const indicators = document.querySelectorAll(".indicator");
        let currentSlide = 0;
        let slideTimer;

        function loadSlideBg(index) {
          const bg = backgrounds[index];
          if (bg && bg.dataset.bg && !bg.style.backgroundImage) {
            bg.style.backgroundImage = "url('" + bg.dataset.bg + "')";
          }
        }

        function showSlide(index) {
          loadSlideBg(index);
          backgrounds.forEach((bg) => bg.classList.remove("active"));
          indicators.forEach((ind) => ind.classList.remove("active"));

          if (backgrounds[index]) backgrounds[index].classList.add("active");
          if (indicators[index]) indicators[index].classList.add("active");

          currentSlide = index;
        }

        function nextSlide() {
          let next = (currentSlide + 1) % backgrounds.length;
          showSlide(next);
        }

        indicators.forEach((ind) => {
          ind.addEventListener("click", function () {
            clearInterval(slideTimer);
            showSlide(parseInt(this.dataset.slide));
            slideTimer = setInterval(nextSlide, 6000);
          });
        });

        // Preload next image
        if (backgrounds.length > 1) loadSlideBg(1);
        slideTimer = setInterval(nextSlide, 6000);

        // Featured Tours Carousel
        const track = document.getElementById("carouselTrack");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const dots = document.querySelectorAll(".carousel-dot");
        const slides = document.querySelectorAll(".carousel-slide");

        if (track && slides.length > 0) {
          let carouselIndex = 0;

          function getVisibleSlides() {
            if (window.innerWidth < 768) return 1;
            if (window.innerWidth < 1024) return 2;
            return 3;
          }

          function getMaxIndex() {
            const visible = getVisibleSlides();
            return Math.max(0, slides.length - visible);
          }

          function updateCarousel() {
            const visible = getVisibleSlides();
            const slideWidth = 100 / visible;
            track.style.transform = `translateX(-${carouselIndex * slideWidth}%)`;

            dots.forEach((d, idx) => {
              d.classList.toggle("active", idx === carouselIndex);
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener("click", function () {
              const max = getMaxIndex();
              carouselIndex = carouselIndex < max ? carouselIndex + 1 : 0;
              updateCarousel();
            });
          }

          if (prevBtn) {
            prevBtn.addEventListener("click", function () {
              const max = getMaxIndex();
              carouselIndex = carouselIndex > 0 ? carouselIndex - 1 : max;
              updateCarousel();
            });
          }

          dots.forEach((dot) => {
            dot.addEventListener("click", function () {
              carouselIndex = Math.min(parseInt(this.dataset.slide), getMaxIndex());
              updateCarousel();
            });
          });

          window.addEventListener("resize", updateCarousel);
        }
      });
    </script>
  </body>
