<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Bookings | OrbitRush Tourism</title>
    <%- include("../partials/head") %>
    <style>
      .my-bookings-page {
        background-color: var(--orbit-light);
        min-height: 100vh;
        padding-bottom: 6rem;
      }

      /* Hero Header */
      .bookings-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 70%, #0369a1 100%);
        color: white;
        padding: 4rem 0 5rem;
        text-align: center;
      }

      .bookings-hero-title {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
        color: #ffffff;
      }

      .bookings-hero-subtitle {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 600px;
        margin: 0 auto;
      }

      .bookings-content-wrap {
        max-width: 1100px;
        margin: -3rem auto 0;
        position: relative;
        z-index: 10;
      }

      /* Booking Item Card */
      .booking-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        overflow: hidden;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-md);
        margin-bottom: 2rem;
        transition: var(--orbit-transition);
      }

      .booking-card:hover {
        box-shadow: var(--orbit-shadow-lg);
      }

      .booking-card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .booking-tour-name {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin: 0;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 1rem;
        border-radius: var(--orbit-radius-full);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .status-pill.confirmed {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
      }

      .status-pill.cancelled {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }

      .booking-body {
        padding: 2rem;
      }

      /* Refund Banner */
      .refund-status-box {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #22c55e;
        padding: 1.2rem 1.5rem;
        border-radius: var(--orbit-radius-sm);
        margin-bottom: 1.5rem;
        color: #166534;
      }

      .refund-status-box.failed {
        background: #fef2f2;
        border-color: #fecaca;
        border-left-color: #ef4444;
        color: #991b1b;
      }

      /* Booking Meta Grid */
      .booking-details-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .booking-detail-cell {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-sm);
        padding: 1rem 1.2rem;
      }

      .detail-label-text {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 2px;
      }

      .detail-val-text {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--orbit-dark);
      }

      /* Travelers Box */
      .travelers-list-wrap {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: var(--orbit-radius-md);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .travelers-heading {
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--orbit-dark);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .traveler-pill-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
      }

      /* Actions & Cancellation Bar */
      .booking-actions-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.25rem;
        border-top: 1px solid #f1f5f9;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .btn-cancel-action {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 0.65rem 1.4rem;
        border-radius: var(--orbit-radius-full);
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: var(--orbit-transition);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      .btn-cancel-action:hover {
        background: #ef4444;
        color: #ffffff;
        border-color: #ef4444;
      }

      /* Empty State */
      .empty-booking-card {
        background: #ffffff;
        border-radius: var(--orbit-radius-lg);
        padding: 5rem 2rem;
        text-align: center;
        border: 1px solid var(--orbit-border);
        box-shadow: var(--orbit-shadow-md);
      }

      @media (max-width: 768px) {
        .booking-details-grid {
          grid-template-columns: 1fr;
        }
        .traveler-pill-row {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.3rem;
        }
      }
    </style>
  </head>

  <body class="my-bookings-page">
    <%- include("../partials/nav") %>

    <!-- Hero Header -->
    <section class="bookings-hero">
      <div class="container">
        <h1 class="bookings-hero-title">My Journey Reservations</h1>
        <p class="bookings-hero-subtitle">
          Manage your confirmed expeditions, view traveler credentials, and track real-time refund statuses.
        </p>
      </div>
    </section>

    <!-- Main Bookings Container -->
    <div class="container">
      <div class="bookings-content-wrap">
        <% if (bookings && bookings.length > 0) { %>
          <% bookings.forEach(function(booking) { 
            const startDate = new Date(booking.travelDate);
            const formattedStartDate = startDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
            
            // Calculate end date based on tour duration if available, or default
            let formattedEndDate = 'Flexible Departure';
            if (booking.tourDuration) {
              const days = parseInt(booking.tourDuration) || 1;
              const endDate = new Date(startDate);
              endDate.setDate(endDate.getDate() + days);
              formattedEndDate = endDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
            }

            // Check 24 hour cancellation eligibility
            const bookedTime = new Date(booking.createdAt).getTime();
            const now = Date.now();
            const isCancelable = booking.status !== 'CANCELLED' && (now - bookedTime) <= (24 * 60 * 60 * 1000);
          %>
            <article class="booking-card">
              <div class="booking-card-header">
                <h3 class="booking-tour-name"><%= booking.tourName %></h3>
                <div>
                  <% if (booking.status === 'CANCELLED') { %>
                    <span class="status-pill cancelled">
                      <i class="fas fa-ban"></i> Cancelled & Refunded
                    </span>
                  <% } else { %>
                    <span class="status-pill confirmed">
                      <i class="fas fa-check-circle"></i> Confirmed & Active
                    </span>
                  <% } %>
                </div>
              </div>

              <div class="booking-body">
                <% if (booking.status === 'CANCELLED') { %>
                  <div class="refund-status-box <%= booking.refundStatus === 'FAILED' ? 'failed' : '' %>">
                    <h4 style="margin: 0 0 6px 0; font-size: 1.05rem; font-weight: 700;">
                      <i class="fas fa-hand-holding-usd me-1"></i> Refund Status: <strong><%= booking.refundStatus %></strong>
                    </h4>
                    <p style="margin: 0; font-size: 0.9rem;">
                      <strong>Refund Amount:</strong> ₹<%= (booking.refundAmount || booking.amount).toLocaleString('en-IN') %>
                      <% if (booking.refundId) { %>
                        | <strong>Refund ID:</strong> <code><%= booking.refundId %></code>
                      <% } %>
                    </p>
                    <% if (booking.cancelledAt) { %>
                      <p style="margin: 4px 0 0 0; font-size: 0.82rem; opacity: 0.85;">
                        Cancelled on: <%= new Date(booking.cancelledAt).toLocaleString('en-IN') %>
                      </p>
                    <% } %>
                  </div>
                <% } %>

                <div class="booking-details-grid">
                  <div class="booking-detail-cell">
                    <div class="detail-label-text">Trip Start Date</div>
                    <div class="detail-val-text"><%= formattedStartDate %></div>
                  </div>

                  <div class="booking-detail-cell">
                    <div class="detail-label-text">Party Size</div>
                    <div class="detail-val-text"><%= booking.numberOfPeople %> Traveler(s)</div>
                  </div>

                  <div class="booking-detail-cell">
                    <div class="detail-label-text">Total Paid</div>
                    <div class="detail-val-text" style="color: #10b981;">₹<%= booking.amount.toLocaleString('en-IN') %></div>
                  </div>

                  <div class="booking-detail-cell">
                    <div class="detail-label-text">Payment ID</div>
                    <div class="detail-val-text" style="font-size: 0.85rem; font-family: monospace;">
                      <%= booking.paymentId || 'N/A' %>
                    </div>
                  </div>

                  <div class="booking-detail-cell">
                    <div class="detail-label-text">Booking Reference</div>
                    <div class="detail-val-text" style="font-size: 0.85rem; font-family: monospace;">
                      <%= booking._id %>
                    </div>
                  </div>

                  <div class="booking-detail-cell">
                    <div class="detail-label-text">Reservation Placed</div>
                    <div class="detail-val-text" style="font-size: 0.9rem;">
                      <%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </div>
                  </div>
                </div>

                <!-- Travelers List -->
                <div class="travelers-list-wrap">
                  <div class="travelers-heading">
                    <i class="fas fa-users text-primary"></i> Registered Travelers
                  </div>
                  <% (booking.travelers || []).forEach(function(traveler, index) { %>
                    <div class="traveler-pill-row">
                      <span style="font-weight: 700; color: var(--orbit-dark);">
                        <i class="fas fa-user text-muted me-2"></i> <%= index + 1 %>. <%= traveler.name %>
                      </span>
                      <span class="text-muted" style="font-family: monospace; font-size: 0.85rem;">
                        Aadhaar: <%= traveler.aadhaarNumber %>
                      </span>
                    </div>
                  <% }); %>
                </div>

                <!-- Actions Strip -->
                <div class="booking-actions-strip">
                  <div style="font-size: 0.85rem; color: #64748b;">
                    <% if (booking.status === 'CANCELLED') { %>
                      <i class="fas fa-info-circle text-muted"></i> Booking refund processed via Razorpay.
                    <% } else if (isCancelable) { %>
                      <i class="fas fa-clock text-warning"></i> Cancellation window active (eligible within 24 hours of booking).
                    <% } else { %>
                      <i class="fas fa-lock text-muted"></i> 24-hour cancellation window closed.
                    <% } %>
                  </div>

                  <% if (isCancelable) { %>
                    <button
                      class="btn-cancel-action"
                      onclick="cancelBooking('<%= booking._id %>')"
                    >
                      <i class="fas fa-times-circle"></i> Cancel & Request Refund
                    </button>
                  <% } %>
                </div>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <div class="empty-booking-card">
            <i class="fas fa-suitcase-rolling fa-4x text-muted mb-3 opacity-50"></i>
            <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--orbit-dark); margin-bottom: 0.5rem;">
              No Reservations Found
            </h2>
            <p style="color: #64748b; max-width: 450px; margin: 0 auto 1.5rem;">
              You haven't reserved an expedition yet. Discover our curated itineraries and start your adventure today.
            </p>
            <a href="/tour" class="btn-orbit-hero btn-orbit-primary">
              <i class="fas fa-compass"></i> Explore Tours
            </a>
          </div>
        <% } %>
      </div>
    </div>

    <%- include("../partials/scripts") %>

    <script>
      async function cancelBooking(bookingId) {
        const reason = prompt("Please provide a cancellation reason (optional):");
        if (reason === null) return;

        if (!confirm("Are you sure you want to cancel this booking? A 100% full refund will be initiated via Razorpay.")) {
          return;
        }

        try {
          const res = await fetch(`/booking/cancel/${bookingId}`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ reason }),
          });

          const data = await res.json();
          if (data.success) {
            alert("✅ " + data.message);
            window.location.reload();
          } else {
            alert("❌ " + (data.error || "Failed to cancel booking"));
          }
        } catch (err) {
          console.error(err);
          alert("❌ Something went wrong while cancelling the booking.");
        }
      }
    </script>
  </body>
</html>
