<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Bookings | OrbitRush Tourism</title>
    <%- include("../partials/head") %>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <style>
      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 2rem 0;
        font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .page-header {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        text-align: center;
      }

      .page-header h1 {
        margin: 0;
        color: #2c3e50;
        font-size: 2.5rem;
        font-weight: 800;
      }

      .page-header p {
        margin: 0.5rem 0 0 0;
        color: #6c757d;
        font-size: 1.1rem;
      }

      .booking-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        transition: all 0.3s;
      }

      .booking-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
      }

      .booking-header {
        background: linear-gradient(135deg, #ff6b35, #f7931e);
        color: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .booking-card.cancelled-card .booking-header {
        background: linear-gradient(135deg, #64748b, #475569);
      }

      .booking-header h3 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
      }

      .status-badges {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .booking-status {
        background: rgba(255, 255, 255, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
      }

      .booking-status.cancelled {
        background: #ef4444;
        color: white;
      }

      .booking-status.completed {
        background: #4caf50;
      }

      .booking-body {
        padding: 2rem;
      }

      .booking-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }

      .detail-label {
        font-size: 0.85rem;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .detail-value {
        font-size: 1.05rem;
        color: #2c3e50;
        font-weight: 700;
      }

      .refund-banner {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-left: 5px solid #22c55e;
        padding: 1.2rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        color: #166534;
      }

      .refund-banner.failed {
        background: #fef2f2;
        border-color: #fecaca;
        border-left-color: #ef4444;
        color: #991b1b;
      }

      .travelers-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
        margin-top: 1.5rem;
      }

      .travelers-title {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 1rem;
        font-size: 1.1rem;
      }

      .traveler-item {
        background: white;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 0.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .traveler-name {
        font-weight: 600;
        color: #2c3e50;
      }

      .traveler-aadhaar {
        font-family: monospace;
        color: #667eea;
        font-weight: 600;
      }

      .card-actions {
        margin-top: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #e2e8f0;
        padding-top: 1.2rem;
      }

      .btn-cancel-booking {
        background: #ef4444;
        color: white;
        border: none;
        padding: 0.7rem 1.4rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .btn-cancel-booking:hover {
        background: #dc2626;
      }

      .cancellation-window-info {
        font-size: 0.85rem;
        color: #64748b;
      }

      .empty-state {
        background: white;
        border-radius: 20px;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      }

      .empty-state i {
        font-size: 5rem;
        color: #e9ecef;
        margin-bottom: 1rem;
      }

      .empty-state h2 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
      }

      .empty-state p {
        color: #6c757d;
        margin-bottom: 2rem;
      }

      .btn-browse {
        display: inline-block;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s;
      }

      @media (max-width: 768px) {
        .booking-details {
          grid-template-columns: 1fr;
        }

        .booking-header {
          flex-direction: column;
          gap: 1rem;
        }

        .card-actions {
          flex-direction: column;
          gap: 1rem;
          align-items: stretch;
        }
      }
    </style>
  </head>
  <body>
    <%- include("../partials/nav") %>

    <div class="container">
      <div class="page-header">
        <h1>🎫 My Bookings</h1>
        <p>View your upcoming trips, cancellation status, and refund details</p>
      </div>

      <% if (bookings && bookings.length > 0) { %>
        <% bookings.forEach(function(booking) { %>
          <%
            var now = Date.now();
            var createdTime = new Date(booking.createdAt).getTime();
            var hoursDiff = (now - createdTime) / (1000 * 60 * 60);
            var isCancelable = booking.status !== "CANCELLED" && hoursDiff <= 24;

            var startDateObj = booking.tripStartDate || booking.travelDate;
            var endDateObj = booking.tripEndDate || startDateObj;

            var formattedStartDate = new Date(startDateObj).toLocaleDateString('en-IN', {
              day: 'numeric', month: 'short', year: 'numeric'
            });
            var formattedEndDate = new Date(endDateObj).toLocaleDateString('en-IN', {
              day: 'numeric', month: 'short', year: 'numeric'
            });
          %>

          <div class="booking-card <%= booking.status === 'CANCELLED' ? 'cancelled-card' : '' %>">
            <div class="booking-header">
              <h3><%= booking.tourName %></h3>
              <div class="status-badges">
                <% if (booking.status === 'CANCELLED') { %>
                  <span class="booking-status cancelled">
                    <i class="fas fa-ban"></i> CANCELLED
                  </span>
                <% } else { %>
                  <span class="booking-status completed">
                    ✓ CONFIRMED
                  </span>
                <% } %>
              </div>
            </div>

            <div class="booking-body">
              <% if (booking.status === 'CANCELLED') { %>
                <div class="refund-banner <%= booking.refundStatus === 'FAILED' ? 'failed' : '' %>">
                  <h4 style="margin: 0 0 6px 0; font-size: 1.05rem;">
                    <i class="fas fa-hand-holding-usd"></i> Refund Status: <strong><%= booking.refundStatus %></strong>
                  </h4>
                  <p style="margin: 0; font-size: 0.9rem;">
                    <strong>Refund Amount:</strong> ₹<%= (booking.refundAmount || booking.amount).toLocaleString('en-IN') %>
                    <% if (booking.refundId) { %>
                      | <strong>Refund ID:</strong> <code><%= booking.refundId %></code>
                    <% } %>
                  </p>
                  <% if (booking.cancelledAt) { %>
                    <p style="margin: 4px 0 0 0; font-size: 0.8rem; opacity: 0.85;">
                      Cancelled on: <%= new Date(booking.cancelledAt).toLocaleString('en-IN') %>
                    </p>
                  <% } %>
                </div>
              <% } %>

              <div class="booking-details">
                <div class="detail-item">
                  <span class="detail-label">Trip Start Date</span>
                  <span class="detail-value"><%= formattedStartDate %></span>
                </div>

                <div class="detail-item">
                  <span class="detail-label">Trip End Date</span>
                  <span class="detail-value"><%= formattedEndDate %></span>
                </div>

                <div class="detail-item">
                  <span class="detail-label">Travelers</span>
                  <span class="detail-value"><%= booking.numberOfPeople %> Person(s)</span>
                </div>

                <div class="detail-item">
                  <span class="detail-label">Total Paid</span>
                  <span class="detail-value" style="color: #10b981;">₹<%= booking.amount.toLocaleString('en-IN') %></span>
                </div>

                <div class="detail-item">
                  <span class="detail-label">Payment ID</span>
                  <span class="detail-value" style="font-size: 0.85rem; font-family: monospace;">
                    <%= booking.paymentId || 'N/A' %>
                  </span>
                </div>

                <div class="detail-item">
                  <span class="detail-label">Booking ID</span>
                  <span class="detail-value" style="font-size: 0.85rem; font-family: monospace;">
                    <%= booking._id %>
                  </span>
                </div>
              </div>

              <!-- Travelers List -->
              <div class="travelers-section">
                <div class="travelers-title">
                  <i class="fas fa-users"></i> Traveler Details
                </div>
                <% booking.travelers.forEach(function(traveler, index) { %>
                  <div class="traveler-item">
                    <span class="traveler-name">
                      <i class="fas fa-user me-2"></i> <%= index + 1 %>. <%= traveler.name %>
                    </span>
                    <span class="traveler-aadhaar">
                      Aadhaar: <%= traveler.aadhaarNumber %>
                    </span>
                  </div>
                <% }); %>
              </div>

              <!-- Actions Section (24h Cancellation) -->
              <div class="card-actions">
                <div class="cancellation-window-info">
                  <% if (booking.status === 'CANCELLED') { %>
                    <i class="fas fa-info-circle text-muted"></i> This booking has been cancelled and refunded.
                  <% } else if (isCancelable) { %>
                    <i class="fas fa-clock text-warning"></i> Cancellation window active (eligible within 24 hours of booking).
                  <% } else { %>
                    <i class="fas fa-lock text-muted"></i> Cancellation window closed (24 hours passed).
                  <% } %>
                </div>

                <% if (isCancelable) { %>
                  <button
                    class="btn-cancel-booking"
                    onclick="cancelBooking('<%= booking._id %>')"
                  >
                    <i class="fas fa-times-circle"></i> Cancel Booking & Refund
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-suitcase-rolling"></i>
          <h2>No Bookings Yet</h2>
          <p>Start your adventure by booking your first tour!</p>
          <a href="/tour" class="btn-browse">
            <i class="fas fa-compass"></i> Browse Tours
          </a>
        </div>
      <% } %>
    </div>

    <%- include("../partials/scripts") %>

    <script>
      async function cancelBooking(bookingId) {
        const reason = prompt("Please enter a reason for cancellation (optional):");
        if (reason === null) return; // User clicked cancel

        if (!confirm("Are you sure you want to cancel this booking? A full refund will be processed via Razorpay.")) {
          return;
        }

        try {
          const res = await fetch(`/booking/cancel/${bookingId}`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ reason }),
          });

          const data = await res.json();
          if (data.success) {
            alert("✅ " + data.message);
            window.location.reload();
          } else {
            alert("❌ " + (data.error || "Failed to cancel booking"));
          }
        } catch (err) {
          console.error(err);
          alert("❌ Something went wrong while cancelling the booking.");
        }
      }
    </script>
  </body>
</html>
