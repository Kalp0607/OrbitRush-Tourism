<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <title>Forgot Password | OrbitRush Tourism</title>
    <style>
      body {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      }
      .form-control {
        border-radius: 0.5rem;
      }
      .btn-primary {
        border-radius: 0.5rem;
        padding: 0.6rem 1.2rem;
        font-weight: 500;
      }
      .header-title {
        text-align: center;
        font-weight: 600;
        color: #2a5298;
      }
    </style>
  </head>
  <body>
    <%- include("partials/nav") %>

    <div class="container d-flex justify-content-center align-items-center flex-grow-1">
      <div class="card p-4 mt-5" style="max-width: 400px; width: 100%">
        <h3 class="header-title mb-3">Forgot Password 🔐</h3>
        <p class="text-center text-muted mb-4">
          Enter your registered email address to receive an OTP.
        </p>

        <% if (locals.error) { %>
        <div class="alert alert-danger text-center mb-3" role="alert">
          <%= locals.error %>
        </div>
        <% } %>

        <form action="/user/forgot-password/send" method="POST">
          <div class="mb-3">
            <label for="email" class="form-label fw-semibold">Email address</label>
            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              placeholder="Enter your registered email"
              required
            />
          </div>

          <div class="d-grid mt-4">
            <button type="submit" class="btn btn-primary">Send Reset OTP</button>
          </div>

          <p class="text-center mt-3 mb-0 text-muted">
            Remembered your password?
            <a href="/user/signin" class="text-decoration-none fw-semibold">Sign In</a>
          </p>
        </form>
      </div>
    </div>

    <%- include("partials/scripts") %>
  </body>
</html>
